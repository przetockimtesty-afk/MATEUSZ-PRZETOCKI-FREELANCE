!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"width\":\"22%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:22%\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Branże</h2>\n<!-- /wp:heading -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li><a href=\"/dla-kogo/doradcy-kredytowi/\">Doradcy kredytowi</a></li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li><a href=\"/dla-kogo/biura-rachunkowe/\">Biura rachunkowe</a></li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li><a href=\"/dla-kogo/psycholodzy-i-terapeuci/\">Psycholodzy i terapeuci</a></li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li><a href=\"/dla-kogo/\">Wszystkie branże</a></li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"width\":\"22%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:22%\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Na skróty</h2>\n<!-- /wp:heading -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li><a href=\"/realizacje/\">Realizacje</a></li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li><a href=\"/jak-pracuje/\">Jak pracuję</a></li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li><a href=\"/o-mnie/\">O mnie</a></li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li><a href=\"/pytania/\">Pytania</a></li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li><a href=\"/kontakt/\">Kontakt</a></li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:group {\"className\":\"mp-stopka-dol\",\"style\":{\"spacing\":{\"blockGap\":\"12px 20px\"}},\"layout\":{\"type\":\"flex\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group mp-stopka-dol\"><!-- wp:paragraph -->\n<p>Mateusz Przetocki · [adres z danych z ustawy] · kontakt@…</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p><a href=\"/pol