 "content": {
  "raw": "<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"clamp(24px, 2.8vw, 40px)\",\"bottom\":\"clamp(56px, 6.7vw, 96px)\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull\" style=\"padding-top:clamp(24px, 2.8vw, 40px);padding-bottom:clamp(56px, 6.7vw, 96px)\"><!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|50\"}}} -->\n<div class=\"wp-block-group alignwide\"><!-- wp:paragraph {\"className\":\"is-style-okruszki\"} -->\n<p class=\"is-style-okruszki\"><a href=\"/\">Strona główna</a> › <a href=\"/dla-kogo/\">Dla kogo</a> › Doradcy kredytowi</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\":\"mp-hero-tekst\",\"style\":{\"spacing\":{\"blockGap\":\"22px\"}}} -->\n<div class=\"wp-block-group mp-hero-tekst\"><!-- wp:paragraph {\"className\":\"is-style-nadtytul\"} -->\n<p class=\"is-style-nadtytul\">01 · Finanse</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":1} -->\n<h1 class=\"wp-block-heading\">Strona dla doradcy kredytowego, która <em>umawia</em> konsultacje</h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"is-style-wstep\"} -->\n<p class=\"is-style-wstep\">Klient z polecenia szuka Cię wieczorem. Formularz wstępnej analizy i kalendarz sprawiają, że umawia się od razu, a nie rano u kogoś innego.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\":\"mp-etykiety\",\"style\":{\"spacing\":{\"blockGap\":\"6px\"}},\"layout\":{\"type\":\"flex\"}} -->\n<div class=\"wp-block-group mp-etykiety\"><!-- wp:paragraph {\"className\":\"is-style-etykieta\"} -->\n<p class=\"is-style-etykieta\">formularz analizy</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"is-style-etykieta\"} -->\n<p class=\"is-style-etykieta\">kalendarz</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"is-style-etykieta\"} -->\n<p class=\"is-style-etykieta\">informacje KNF</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"ze-strzalka\"} -->\n<div class=\"wp-block-button ze-strzalka\"><a class=\"wp-block-button__link wp-element-button\" href=\"#ankieta\">Wyceń stronę w 5 minut</a></div>\n<!-- /wp:button -->\n\n<!-- wp:button {\"className\":\"is-style-outline\"} -->\n<div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"#demo\">Zobacz demo</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->\n\n<!-- wp:paragraph {\"className\":\"is-style-podpis\"} -->\n<p class=\"is-style-podpis\">Bez zobowiązań · propozycja w 48 h</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"backgroundColor\":\"piasek\",\"align\":\"full\",\"anchor\":\"problem\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"clamp(72px, 8.4vw, 120px)\",\"bottom\":\"clamp(72px, 8.4vw, 120px)\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull has-piasek-background-color has-background\" id=\"problem\" style=\"padding-top:clamp(72px, 8.4vw, 120px);padding-bottom:clamp(72px, 8.4vw, 120px)\"><!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|50\"}}} -->\n<div class=\"wp-block-group alignwide\"><!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column {\"width\":\"40%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:40%\"><!-- wp:paragraph {\"className\":\"is-style-nadtytul\"} -->\n<p class=\"is-style-nadtytul\">Problem</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Polecony klient nie <em>czeka</em> do rana</h2>\n<!-- /wp:heading --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"width\":\"60%\",\"className\":\"mp-akapity\"} -->\n<div class=\"wp-block-column mp-akapity\" style=\"flex-basis:60%\"><!-- wp:paragraph -->\n<p>Klient z polecenia dzwoni, kiedy jesteś na spotkaniu z innym klientem. Wieczorem może tylko zostawić numer, a rano porównuje już dwie oferty.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>A pierwsza konsultacja i tak idzie na podstawy: kwotę, wkład własny i formę zatrudnienia.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"anchor\":\"co-dostajesz\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"clamp(72px, 8.4vw, 120px)\",\"bottom\":\"clamp(72px, 8.4vw, 120px)\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull\" id=\"co-dostajesz\" style=\"padding-top:clamp(72px, 8.4vw, 120px);padding-bottom:clamp(72px, 8.4vw, 120px)\"><!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|50\"}}} -->\n<div class=\"wp-block-group alignwide\"><!-- wp:group {\"className\":\"mp-naglowek-sekcji\",\"style\":{\"spacing\":{\"blockGap\":\"22px\"}}} -->\n<div class=\"wp-block-group mp-naglowek-sekcji\"><!-- wp:paragraph {\"className\":\"is-style-nadtytul\"} -->\n<p class=\"is-style-nadtytul\">Co dostajesz</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Konsultacja, na którą klient przychodzi <em>przygotowany</em></h2>\n<!-- /wp:heading --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"20px\"}},\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"300px\"}} -->\n<div class=\"wp-block-group\"><!-- wp:group {\"className\":\"is-style-karta\"} -->\n<div class=\"wp-block-group is-style-karta\"><!-- wp:html -->\n<span class=\"mp-ikona\" aria-hidden=\"true\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M8 2v3\"/> <path d=\"M16 2v3\"/> <rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/> <path d=\"M3 9h18\"/> <path d=\"m9 15 2 2 4-4\"/></svg></span>\n<!-- /wp:html -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Klient umawia konsultację w 2 kliknięciach</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Kalendarz pokazuje tylko Twoje wolne terminy, także wieczorem.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-karta\"} -->\n<div class=\"wp-block-group is-style-karta\"><!-- wp:html -->\n<span class=\"mp-ikona\" aria-hidden=\"true\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><rect width=\"8\" height=\"4\" x=\"8\" y=\"2\" rx=\"1\" ry=\"1\"/> <path d=\"M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2\"/> <path d=\"M12 11h4\"/> <path d=\"M12 16h4\"/> <path d=\"M8 11h.01\"/> <path d=\"M8 16h.01\"/></svg></span>\n<!-- /wp:html -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Zanim przyjdzie, wiesz, jakiej kwoty szuka i ile ma wkładu własnego</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Formularz wstępnej analizy z przedziałami kwot.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-karta\"} -->\n<div class=\"wp-block-group is-style-karta\"><!-- wp:html -->\n<span class=\"mp-ikona\" aria-hidden=\"true\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719\"/> <path d=\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"/> <path d=\"M12 17h.01\"/></svg></span>\n<!-- /wp:html -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Odpowiedzi na pytania o dokumenty i wkład własny</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Napisane z Twojej ankiety, Twoimi słowami.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-karta\"} -->\n<div class=\"wp-block-group is-style-karta\"><!-- wp:html -->\n<span class=\"mp-ikona\" aria-hidden=\"true\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z\"/> <path d=\"M14 2v5a1 1 0 0 0 1 1h5\"/> <path d=\"M10 9H8\"/> <path d=\"M16 13H8\"/> <path d=\"M16 17H8\"/></svg></span>\n<!-- /wp:html -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Informacje formalne w jednym miejscu</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Wpis do rejestru KNF i informacje, których wymaga ustawa.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-karta\"} -->\n<div class=\"wp-block-group is-style-karta\"><!-- wp:html -->\n<span class=\"mp-ikona\" aria-hidden=\"true\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2\"/> <circle cx=\"12\" cy=\"7\" r=\"4\"/></svg></span>\n<!-- /wp:html -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Dane i logo sieci, jeśli w niej działasz</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Klient od razu widzi, z kim współpracujesz.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"anchor\":\"jak-wyglada\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"0\",\"bottom\":\"clamp(72px, 8.4vw, 120px)\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull\" id=\"jak-wyglada\" style=\"padding-top:0;padding-bottom:clamp(72px, 8.4vw, 120px)\"><!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|50\"}}} -->\n<div class=\"wp-block-group alignwide\"><!-- wp:group {\"className\":\"mp-naglowek-sekcji mp-srodek\",\"style\":{\"spacing\":{\"blockGap\":\"22px\"}}} -->\n<div class=\"wp-block-group mp-naglowek-sekcji mp-srodek\"><!-- wp:paragraph {\"align\":\"center\",\"className\":\"is-style-nadtytul\"} -->\n<p class=\"is-style-nadtytul\">Jak to wygląda</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Demo strony <em>ekspertki</em> kredytowej</h2>\n<!-- /wp:heading --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"mp-ekrany\",\"style\":{\"spacing\":{\"blockGap\":\"32px\"}},\"layout\":{\"type\":\"flex\",\"flexWrap\":\"nowrap\",\"justifyContent\":\"center\",\"verticalAlignment\":\"top\"}} -->\n<div class=\"wp-block-group mp-ekrany\"><!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<div class=\"wp-block-group\"><!-- wp:image {\"id\":16,\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-full\"><img src=\"https://mateuszprzetocki.pl/wp-content/uploads/2026/10/doradcy-rezerwacja.webp\" alt=\"Ekran rezerwacji konsultacji z dema\" class=\"wp-image-16\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:paragraph {\"className\":\"mp-opis\"} -->\n<p class=\"mp-opis\">Klient wybiera termin, także wieczorem</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<div class=\"wp-block-group\"><!-- wp:image {\"id\":17,\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-full\"><img src=\"https://mateuszprzetocki.pl/wp-content/uploads/2026/10/doradcy-formularz.webp\" alt=\"Formularz wstępnej analizy z przedziałami kwot\" class=\"wp-image-17\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:paragraph {\"className\":\"mp-opis\"} -->\n<p class=\"mp-opis\">Odpowiada na 3 pytania w przedziałach</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<div class=\"wp-block-group\"><!-- wp:image {\"id\":13,\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-full\"><img src=\"https://mateuszprzetocki.pl/wp-content/uploads/2026/10/telefon-potwierdzenie.webp\" alt=\"Potwierdzenie rezerwacji na czwartek 19:30\" class=\"wp-image-13\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:paragraph {\"className\":\"mp-opis\"} -->\n<p class=\"mp-opis\">Ty rano masz komplet informacji</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"16px 28px\"}},\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-group\"><!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"is-style-outline ze-strzalka\"} -->\n<div class=\"wp-block-button is-style-outline ze-strzalka\"><a class=\"wp-block-button__link wp-element-button\" href=\"#demo\">Zobacz demo na żywo</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->\n\n<!-- wp:paragraph {\"className\":\"is-style-strzalka\"} -->\n<p class=\"is-style-strzalka\"><a href=\"/realizacje/demo-doradca-kredytowy/\">Opis przykładu</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"backgroundColor\":\"piasek\",\"align\":\"full\",\"anchor\":\"przepisy\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"clamp(72px, 8.4vw, 120px)\",\"bottom\":\"clamp(72px, 8.4vw, 120px)\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull has-piasek-background-color has-background\" id=\"przepisy\" style=\"padding-top:clamp(72px, 8.4vw, 120px);padding-bottom:clamp(72px, 8.4vw, 120px)\"><!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|50\"}}} -->\n<div class=\"wp-block-group alignwide\"><!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column {\"width\":\"40%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:40%\"><!-- wp:paragraph {\"className\":\"is-style-nadtytul\"} -->\n<p class=\"is-style-nadtytul\">Przepisy i zasady</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">O co dbam na stronie <em>doradcy</em></h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"textColor\":\"grafit\"} -->\n<p class=\"has-grafit-color has-text-color\">Strona doradcy ma informować, nie obiecywać. Te punkty sprawdzam przed publikacją.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"width\":\"60%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:60%\"><!-- wp:list {\"className\":\"is-style-lista-tarcza\"} -->\n<ul class=\"wp-block-list is-style-lista-tarcza\"><!-- wp:list-item -->\n<li>Wpis do rejestru KNF i informacje z art. 17 ustawy o kredycie hipotecznym.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Słowa „doradca” i „doradztwo” tylko w zakresie, na który pozwala ustawa.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Stopy i raty tylko z przykładem reprezentatywnym.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Formularz z przedziałami kwot, bez PESEL i skanów dokumentów.</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"anchor\":\"pakiet\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"clamp(72px, 8.4vw, 120px)\",\"bottom\":\"clamp(72px, 8.4vw, 120px)\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull\" id=\"pakiet\" style=\"padding-top:clamp(72px, 8.4vw, 120px);padding-bottom:clamp(72px, 8.4vw, 120px)\"><!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|50\"}}} -->\n<div class=\"wp-block-group alignwide\"><!-- wp:columns {\"verticalAlignment\":\"center\"} -->\n<div class=\"wp-block-columns are-vertically-aligned-center\"><!-- wp:column {\"width\":\"55%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:55%\"><!-- wp:paragraph {\"className\":\"is-style-nadtytul\"} -->\n<p class=\"is-style-nadtytul\">Polecany pakiet</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Dla doradcy: wizytówka, która <em>umawia</em></h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Formularz wstępnej analizy i kalendarz konsultacji są w nim od razu. Prostsza wizytówka za 1 200 zł też działa, ale klient nadal musi do Ciebie zadzwonić.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"is-style-strzalka\"} -->\n<p class=\"is-style-strzalka\"><a href=\"/oferta/\">Zobacz wszystkie pakiety</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"width\":\"45%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:45%\"><!-- wp:group {\"tagName\":\"article\",\"className\":\"is-style-pakiet-polecany\",\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<article class=\"wp-block-group is-style-pakiet-polecany\"><!-- wp:paragraph {\"className\":\"is-style-etykieta-czarna\"} -->\n<p class=\"is-style-etykieta-czarna\">Polecam</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Wizytówka, która umawia</h3>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"mp-cena\",\"layout\":{\"type\":\"flex\"}} -->\n<div class=\"wp-block-group mp-cena\"><!-- wp:paragraph -->\n<p>1 800</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>zł</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:paragraph {\"className\":\"mp-dla\"} -->\n<p class=\"mp-dla\">Gdy chcesz mniej telefonów i krótsze pierwsze rozmowy.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list {\"className\":\"is-style-lista-pakiet\"} -->\n<ul class=\"wp-block-list is-style-lista-pakiet\"><!-- wp:list-item -->\n<li>Jedna strona, 6 sekcji, wersja na telefon</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Formularz wstępnej analizy i kalendarz konsultacji</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Odpowiedzi na najczęstsze pytania i miejsce na opinie</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Profil Firmy w Google, gdy firma spełnia wytyczne</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"ze-strzalka\"} -->\n<div class=\"wp-block-button ze-strzalka\"><a class=\"wp-block-button__link wp-element-button\" href=\"#ankieta\">Wyceń stronę w 5 minut</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></article>\n<!-- /wp:group --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"anchor\":\"pytania\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"0\",\"bottom\":\"clamp(72px, 8.4vw, 120px)\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull\" id=\"pytania\" style=\"padding-top:0;padding-bottom:clamp(72px, 8.4vw, 120px)\"><!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|50\"}}} -->\n<div class=\"wp-block-group alignwide\"><!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column {\"width\":\"40%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:40%\"><!-- wp:paragraph {\"className\":\"is-style-nadtytul\"} -->\n<p class=\"is-style-nadtytul\">Pytania doradców</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Zanim <em>zapytasz</em></h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"is-style-strzalka\"} -->\n<p class=\"is-style-strzalka\"><a href=\"/pytania/\">Wszystkie pytania</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"width\":\"60%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:60%\"><!-- wp:group {\"className\":\"mp-pytania\",\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<div class=\"wp-block-group mp-pytania\"><!-- wp:details {\"showContent\":true,\"className\":\"is-style-pytanie\"} -->\n<details class=\"wp-block-details is-style-pytanie\" open><summary>Czy mogę pokazać na stronie oprocentowanie i raty?</summary><!-- wp:paragraph -->\n<p>Tylko z przykładem reprezentatywnym. Dane do przykładu podajesz Ty, a ja pilnuję, żeby stał obok każdej stopy i raty.</p>\n<!-- /wp:paragraph --></details>\n<!-- /wp:details -->\n\n<!-- wp:details {\"className\":\"is-style-pytanie\"} -->\n<details class=\"wp-block-details is-style-pytanie\"><summary>Czy klient wyśle mi przez formularz dokumenty?</summary><!-- wp:paragraph -->\n<p>Nie. Formularz pyta o przedziały kwot i formę zatrudnienia, bez PESEL i skanów. Dokumenty klient przynosi na konsultację.</p>\n<!-- /wp:paragraph --></details>\n<!-- /wp:details -->\n\n<!-- wp:details {\"className\":\"is-style-pytanie\"} -->\n<details class=\"wp-block-details is-style-pytanie\"><summary>Działam w sieci. Czy mogę mieć własną stronę?</summary><!-- wp:paragraph -->\n<p>Tak. Na stronie pokażę dane i logo sieci. Zasady używania logo sprawdzasz w swojej sieci.</p>\n<!-- /wp:paragraph --></details>\n<!-- /wp:details -->\n\n<!-- wp:details {\"className\":\"is-style-pytanie\"} -->\n<details class=\"wp-block-details is-style-pytanie\"><summary>Czy strona pokaże się w Google na „doradca kredytowy Kraków”?</summary><!-- wp:paragraph -->\n<p>Nie obiecuję miejsca w wynikach. Dbam o to, co od niego zależy: szybką stronę, podstawy SEO i Profil Firmy w Google, gdy firma spełnia wytyczne.</p>\n<!-- /wp:paragraph --></details>\n<!-- /wp:details --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"anchor\":\"nastepny-krok\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"0\",\"bottom\":\"clamp(72px, 8.4vw, 120px)\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull\" id=\"nastepny-krok\" style=\"padding-top:0;padding-bottom:clamp(72px, 8.4vw, 120px)\"><!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<div class=\"wp-block-group alignwide\"><!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"22px\"}}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph {\"className\":\"is-style-nadtytul\"} -->\n<p class=\"is-style-nadtytul\">Następny krok</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"backgroundColor\":\"czern\",\"textColor\":\"krem\",\"className\":\"is-style-cta is-style-ciemna\",\"style\":{\"spacing\":{\"blockGap\":\"20px\"}}} -->\n<div class=\"wp-block-group is-style-cta is-style-ciemna has-krem-color has-czern-background-color has-text-color has-background\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Sprawdź, ile kosztowałaby <em>Twoja</em> strona</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>5 minut pytań, jednostronicowa propozycja w 48 godzin. Wypełnienie do niczego nie zobowiązuje.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"ze-strzalka\"} -->\n<div class=\"wp-block-button ze-strzalka\"><a class=\"wp-block-button__link wp-element-button\" href=\"#ankieta\">Wyceń stronę w 5 minut</a></div>\n<!-- /wp:button -->\n\n<!-- wp:button {\"className\":\"is-style-outline\"} -->\n<div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"#rozmowa\">Wolisz porozmawiać? Umów 30 minut</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"mp-zobacz-tez\",\"layout\":{\"type\":\"flex\"}} -->\n<div class=\"wp-block-group mp-zobacz-tez\"><!-- wp:paragraph -->\n<p>Zobacz też:</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"is-style-strzalka\"} -->\n<p class=\"is-style-strzalka\"><a href=\"/dla-kogo/biura-rachunkowe/\">Biura rachunkowe</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"is-style-strzalka\"} -->\n<p class=\"is-style-strzalka\"><a href=\"/dla-kogo/psycholodzy-i-terapeuci/\">Psycholodzy i terapeuci</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->",
  "rendered": "\n<section class=\"wp-block-group alignfull has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\" style=\"padding-top:clamp(24px, 2.8vw, 40px);padding-bottom:clamp(56px, 6.7vw, 96px)\">\n<div class=\"wp-block-group alignwide is-layout-flow wp-container-core-group-is-layout-327af1f9 wp-block-group-is-layout-flow\">\n<p class=\"is-style-okruszki wp-block-paragraph\"><a href=\"/\">Strona główna</a> › <a href=\"/dla-kogo/\">Dla kogo</a> › Doradcy kredytowi</p>\n\n\n\n<div class=\"wp-block-group mp-hero-tekst is-layout-flow wp-container-core-group-is-layout-1e0e26b3 wp-block-group-is-layout-flow\">\n<p class=\"is-style-nadtytul wp-block-paragraph\">01 · Finanse</p>\n\n\n\n<h1 class=\"wp-block-heading\">Strona dla doradcy kredytowego, która <em>umawia</em> konsultacje</h1>\n\n\n\n<p class=\"is-style-wstep wp-block-paragraph\">Klient z polecenia szuka Cię wieczorem. Formularz wstępnej analizy i kalendarz sprawiają, że umawia się od razu, a nie rano u kogoś innego.</p>\n\n\n\n<div class=\"wp-block-group mp-etykiety is-layout-flex wp-container-core-group-is-layout-e0bd8caf wp-block-group-is-layout-flex\">\n<p class=\"is-style-etykieta wp-block-paragraph\">formularz analizy</p>\n\n\n\n<p class=\"is-style-etykieta wp-block-paragraph\">kalendarz</p>\n\n\n\n<p class=\"is-style-etykieta wp-block-paragraph\">informacje KNF</p>\n</div>\n\n\n\n<div class=\"wp-block-buttons is-layout-flex wp-block-buttons-is-layout-flex\">\n<div class=\"wp-block-button ze-strzalka\"><a class=\"wp-block-button__link wp-element-button\" href=\"#ankieta\">Wyceń stronę w 5 minut</a></div>\n\n\n\n<div class=\"wp-block-button is-style-outline is-style-outline--4\"><a class=\"wp-block-button__link wp-element-button\" href=\"#demo\">Zobacz demo</a></div>\n</div>\n\n\n\n<p class=\"is-style-podpis wp-block-paragraph\">Bez zobowiązań · propozycja w 48 h</p>\n</div>\n</div>\n</section>\n\n\n\n<section class=\"wp-block-group alignfull has-piasek-background-color has-background has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\" id=\"problem\" style=\"padding-top:clamp(72px, 8.4vw, 120px);padding-bottom:clamp(72px, 8.4vw, 120px)\">\n<div class=\"wp-block-group alignwide is-layout-flow wp-container-core-group-is-layout-327af1f9 wp-block-group-is-layout-flow\">\n<div class=\"wp-block-columns is-layout-flex wp-container-core-columns-is-layout-a25c9dff wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\" style=\"flex-basis:40%\">\n<p class=\"is-style-nadtytul wp-block-paragraph\">Problem</p>\n\n\n\n<h2 class=\"wp-block-heading\">Polecony klient nie <em>czeka</em> do rana</h2>\n</div>\n\n\n\n<div class=\"wp-block-column mp-akapity is-layout-flow wp-block-column-is-layout-flow\" style=\"flex-basis:60%\">\n<p class=\"wp-block-paragraph\">Klient z polecenia dzwoni, kiedy jesteś na spotkaniu z innym klientem. Wieczorem może tylko zostawić numer, a rano porównuje już dwie oferty.</p>\n\n\n\n<p class=\"wp-block-paragraph\">A pierwsza konsultacja i tak idzie na podstawy: kwotę, wkład własny i formę zatrudnienia.</p>\n</div>\n</div>\n</div>\n</section>\n\n\n\n<section class=\"wp-block-group alignfull has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\" id=\"co-dostajesz\" style=\"padding-top:clamp(72px, 8.4vw, 120px);padding-bottom:clamp(72px, 8.4vw, 120px)\">\n<div class=\"wp-block-group alignwide is-layout-flow wp-container-core-group-is-layout-327af1f9 wp-block-group-is-layout-flow\">\n<div class=\"wp-block-group mp-naglowek-sekcji is-layout-flow wp-container-core-group-is-layout-1e0e26b3 wp-block-group-is-layout-flow\">\n<p class=\"is-style-nadtytul wp-block-paragraph\">Co dostajesz</p>\n\n\n\n<h2 class=\"wp-block-heading\">Konsultacja, na którą klient przychodzi <em>przygotowany</em></h2>\n</div>\n\n\n\n<div class=\"wp-block-group is-layout-grid wp-container-core-group-is-layout-6445e5f0 wp-block-group-is-layout-grid\">\n<div cla