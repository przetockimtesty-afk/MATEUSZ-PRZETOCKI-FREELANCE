4.719\"/> <path d=\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"/> <path d=\"M12 17h.01\"/></svg></span>\n\n\n\n<h3 class=\"wp-block-heading\">Odpowiedzi na pytania o dokumenty i wkład własny</h3>\n\n\n\n<p class=\"wp-block-paragraph\">Napisane z Twojej ankiety, Twoimi słowami.</p>\n</div>\n\n\n\n<div class=\"wp-block-group is-style-karta is-layout-flow wp-block-group-is-layout-flow\">\n<span class=\"mp-ikona\" aria-hidden=\"true\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z\"/> <path d=\"M14 2v5a1 1 0 0 0 1 1h5\"/> <path d=\"M10 9H8\"/> <path d=\"M16 13H8\"/> <path d=\"M16 17H8\"/></svg></span>\n\n\n\n<h3 class=\"wp-block-heading\">Informacje formalne w jednym miejscu</h3>\n\n\n\n<p class=\"wp-block-paragraph\">Wpis do rejestru KNF i informacje, których wymaga ustawa.</p>\n</div>\n\n\n\n<div class=\"wp-block-group is-style-karta is-layout-flow wp-block-group-is-layout-flow\">\n<span class=\"mp-ikona\" aria-hidden=\"true\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2\"/> <circle cx=\"12\" cy=\"7\" r=\"4\"/></svg></span>\n\n\n\n<h3 class=\"wp-block-heading\">Dane i logo sieci, jeśli w niej działasz</h3>\n\n\n\n<p class=\"wp-block-paragraph\">Klient od razu widzi, z kim współpracujesz.</p>\n</div>\n</div>\n</div>\n</section>\n\n\n\n<section class=\"wp-block-group alignfull has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\" id=\"jak-wyglada\" style=\"padding-top:0;padding-bottom:clamp(72px, 8.4vw, 120px)\">\n<div class=\"wp-block-group alignwide is-layout-flow wp-container-core-group-is-layout-327af1f9 wp-block-group-is-layout-flow\">\n<div class=\"wp-block-group mp-naglowek-sekcji mp-srodek is-layout-flow wp-container-core-group-is-layout-1e0e26b3 wp-block-group-is-layout-flow\">\n<p class=\"is-style-nadtytul wp-block-paragraph\">Jak to wygląda</p>\n\n\n\n<h2 class=\"wp-block-heading\">Demo strony <em>ekspertki</em> kredytowej</h2>\n</div>\n\n\n\n<div class=\"wp-block-group mp-ekrany is-content-justification-center is-nowrap is-layout-flex wp-container-core-group-is-layout-c5ad0073 wp-block-group-is-layout-flex\">\n<div class=\"wp-block-group is-layout-flow wp-container-core-group-is-layout-8b1746a0 wp-block-group-is-layout-flow\">\n<figure class=\"wp-block-image size-full\"><img loading=\"lazy\" decoding=\"async\" width=\"472\" height=\"960\" src=\"https://mateuszprzetocki.pl/wp-content/uploads/2026/10/doradcy-rezerwacja.webp\" alt=\"Ekran rezerwacji konsultacji z dema\" class=\"wp-image-16\" srcset=\"https://mateuszprzetocki.pl/wp-content/uploads/2026/10/doradcy-rezerwacja.webp 472w, https://mateuszprzetocki.pl/wp-content/uploads/2026/10/doradcy-rezerwacja-148x300.webp 148w\" sizes=\"auto, (max-width: 472px) 100vw, 472px\" /></figure>\n\n\n\n<p class=\"mp-opis wp-block-paragraph\">Klient wybiera termin, także wieczorem</p>\n</div>\n\n\n\n<div class=\"wp-block-group is-layout-flow wp-container-core-group-is-layout-8b1746a0 wp-block-group-is-layout-flow\">\n<figure class=\"wp-block-image size-full\"><img loading=\"lazy\" decoding=\"async\" width=\"472\" height=\"960\" src=\"https://mateuszprzetocki.pl/wp-content/uploads/2026/10/doradcy-formularz.webp\" alt=\"Formularz wstępnej analizy z przedziałami kwot\" class=\"wp-image-17\" srcset=\"https://mateuszprzetocki.pl/wp-content/uploads/2026/10/doradcy-formularz.webp 472w, https://mateuszprzetocki.pl/wp-content/uploads/2026/10/doradcy-formularz-148x300.webp 148w\" sizes=\"auto, (max-width: 472px) 100vw, 472px\" /></figure>\n\n\n\n<p class=\"mp-opis wp-block-paragraph\">Odpowiada na 3 pytania w przedziałach</p>\n</div>\n\n\n\n<div class=\"wp-block-group is-layout-flow wp-container-core-group-is-layout-8b1746a0 wp-block-group-is-layout-flow\">\n<figure class=\"wp-block-image size-full\"><img loading=\"lazy\" decoding=\"async\" width=\"472\" height=\"960\" src=\"https://mateuszprzetocki.pl/wp-content/uploads/2026/10/telefon-potwierdzenie.webp\" alt=\"Potwierdzenie rezerwacji na czwartek 19:30\" class=\"wp-image-13\" srcset=\"https://mateuszprzetocki.pl/wp-content/uploads/2026/10/telefon-potwierdzenie.webp 472w, https://mateuszprzetocki.pl/wp-content/uploads/2026/10/telefon-potwierdzenie-148x300.webp 148w\" sizes=\"auto, (max-width: 472px) 100vw, 472px\" /></figure>\n\n\n\n<p class=\"mp-opis wp-block-paragraph\">Ty rano masz komplet informacji</p>\n</div>\n</div>\n\n\n\n<div class=\"wp-block-group is-content-justification-center is-layout-flex wp-container-core-group-is-layout-bad974b1 wp-block-group-is-layout-flex\">\n<div class=\"wp-block-buttons is-layout-flex wp-block-buttons-is-layout-flex\">\n<div class=\"wp-block-button is-style-outline ze-strzalka is-style-outline--5\"><a class=\"wp-block-button__link wp-element-button\" href=\"#demo\">Zobacz demo na żywo</a></div>\n</div>\n\n\n\n<p class=\"is-style-strzalka wp-block-paragraph\"><a href=\"/realizacje/demo-doradca-kredytowy/\">Opis przykładu</a></p>\n</div>\n</div>\n</section>\n\n\n\n<section class=\"wp-block-group alignfull has-piasek-background-color has-background has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\" id=\"przepisy\" style=\"padding-top:clamp(72px, 8.4vw, 120px);padding-bottom:clamp(72px, 8.4vw, 120px)\">\n<div class=\"wp-block-group alignwide is-layout-flow wp-container-core-group-is-layout-327af1f9 wp-block-group-is-layout-flow\">\n<div class=\"wp-block-columns is-layout-flex wp-container-core-columns-is-layout-a25c9dff wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\" style=\"flex-basis:40%\">\n<p class=\"is-style-nadtytul wp-block-paragraph\">Przepisy i zasady</p>\n\n\n\n<h2 class=\"wp-block-heading\">O co dbam na stronie <em>doradcy</em></h2>\n\n\n\n<p class=\"has-grafit-color has-text-color wp-block-paragraph\">Strona doradcy ma informować, nie obiecywać. Te punkty sprawdzam przed publikacją.</p>\n</div>\n\n\n\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\" style=\"flex-basis:60%\">\n<ul class=\"wp-block-list is-style-lista-tarcza\">\n<li>Wpis do rejestru KNF i informacje z art. 17 ustawy o kredycie hipotecznym.</li>\n\n\n\n<li>Słowa „doradca” i „doradztwo” tylko w zakresie, na który pozwala ustawa.</li>\n\n\n\n<li>Stopy i raty tylko z przykładem reprezentatywnym.</li>\n\n\n\n<li>Formularz z przedziałami kwot, bez PESEL i skanów dokumentów.</li>\n</ul>\n</div>\n</div>\n</div>\n</section>\n\n\n\n<section class=\"wp-block-group alignfull has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\" id=\"pakiet\" style=\"padding-top:clamp(72px, 8.4vw, 120px);padding-bottom:clamp(72px, 8.4vw, 120px)\">\n<div class=\"wp-block-group alignwide is-layout-flow wp-container-core-group-is-layout-327af1f9 wp-block-group-is-layout-flow\">\n<div class=\"wp-block-columns are-vertically-aligned-center is-layout-flex wp-container-core-columns-is-layout-a25c9dff wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\" style=\"flex-basis:55%\">\n<p class=\"is-style-nadtytul wp-block-paragraph\">Polecany pakiet</p>\n\n\n\n<h2 class=\"wp-block-heading\">Dla doradcy: wizytówka, która <em>umawia</em></h2>\n\n\n\n<p class=\"wp-block-paragraph\">Formularz wstępnej analizy i kalendarz konsultacji są w nim od razu. Prostsza wizytówka za 1 200 zł też działa, ale klient nadal musi do Ciebie zadzwonić.</p>\n\n\n\n<p class=\"is-style-strzalka wp-block-paragraph\"><a href=\"/oferta/\">Zobacz wszystkie pakiety</a></p>\n</div>\n\n\n\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\" style=\"flex-basis:45%\">\n<article class=\"wp-block-group is-style-pakiet-polecany is-layout-flow wp-container-core-group-is-layout-8b1746a0 wp-block-group-is-layout-flow\">\n<p class=\"is-style-etykieta-czarna wp-block-paragraph\">Polecam</p>\n\n\n\n<h3 class=\"wp-block-heading\">Wizytówka, która umawia</h3>\n\n\n\n<div class=\"wp-block-group mp-cena is-layout-flex wp-block-group-is-layout-flex\">\n<p class=\"wp-block-paragraph\">1 800</p>\n\n\n\n<p class=\"wp-block-paragraph\">zł</p>\n</div>\n\n\n\n<p class=\"mp-dla wp-block-paragraph\">Gdy chcesz mniej telefonów i krótsze pierwsze rozmowy.</p>\n\n\n\n<ul class=\"wp-block-list is-style-lista-pakiet\">\n<li>Jedna strona, 6 sekcji, wersja na telefon</li>\n\n\n\n<li>Formularz wstępnej analizy i kalendarz konsultacji</li>\n\n\n\n<li>Odpowiedzi na najczęstsze pytania i miejsce na opinie</li>\n\n\n\n<li>Profil Firmy w Google, gdy firma spełnia wytyczne</li>\n</ul>\n\n\n\n<div class=\"wp-block-buttons is-layout-flex wp-block-buttons-is-layout-flex\">\n<div class=\"wp-block-button ze-strzalka\"><a class=\"wp-block-button__link wp-element-button\" href=\"#ankieta\">Wyceń stronę w 5 minut</a></div>\n</div>\n</article>\n</div>\n</div>\n</div>\n</section>\n\n\n\n<section class=\"wp-block-group alignfull has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\" id=\"pytania\" style=\"padding-top:0;padding-bottom:clamp(72px, 8.4vw, 120px)\">\n<div class=\"wp-block-group alignwide is-layout-flow wp-container-core-group-is-layout-327af1f9 wp-block-group-is-layout-flow\">\n<div class=\"wp-block-columns is-layout-flex wp-container-core-columns-is-layout-a25c9dff wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\" style=\"flex-basis:40%\">\n<p class=\"is-style-nadtytul wp-block-paragraph\">Pytania doradców</p>\n\n\n\n<h2 class=\"wp-block-heading\">Zanim <em>zapytasz</em></h2>\n\n\n\n<p class=\"is-style-strzalka wp-block-paragraph\"><a href=\"/pytania/\">Wszystkie pytania</a></p>\n</div>\n\n\n\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\" style=\"flex-basis:60%\">\n<div class=\"wp-block-group mp-pytania is-layout-flow wp-container-core-group-is-layout-8b1746a0 wp-block-group-is-layout-flow\">\n<details class=\"wp-block-details is-style-pytanie is-layout-flow wp-block-details-is-layout-flow\" open><summary>Czy mogę pokazać na stronie oprocentowanie i raty?</summary>\n<p class=\"wp-block-paragraph\">Tylko z przykładem reprezentatywnym. Dane do przykładu podajesz Ty, a ja pilnuję, żeby stał obok każdej stopy i raty.</p>\n</details>\n\n\n\n<details class=\"wp-block-details is-style-pytanie is-layout-flow wp-block-details-is-layout-flow\"><summary>Czy klient wyśle mi przez formularz dokumenty?</summary>\n<p class=\"wp-block-paragraph\">Nie. Formularz pyta o przedziały kwot i formę zatrudnienia, bez PESEL i skanów. Dokumenty klient przynosi na konsultację.</p>\n</details>\n\n\n\n<details class=\"wp-block-details is-style-pytanie is-layout-flow wp-block-details-is-layout-flow\"><summary>Działam w sieci. Czy mogę mieć własną stronę?</summary>\n<p class=\"wp-block-paragraph\">Tak. Na stronie pokażę dane i logo sieci. Zasady używania logo sprawdzasz w swojej sieci.</p>\n</details>\n\n\n\n<details class=\"wp-block-details is-style-pytanie is-layout-flow wp-block-details-is-layout-flow\"><summary>Czy strona pokaże się w Google na „doradca kredytowy Kraków”?</summary>\n<p class=\"wp-block-paragraph\">Nie obiecuję miejsca w wynikach. Dbam o to, co od niego zależy: szybką stronę, podstawy SEO i Profil Firmy w Google, gdy firma spełnia wytyczne.</p>\n</details>\n</div>\n</div>\n</div>\n</div>\n</section>\n\n\n\n<section class=\"wp-block-group alignfull has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\" id=\"nastepny-krok\" style=\"padding-top:0;padding-bottom:clamp(72px, 8.4vw, 120px)\">\n<div class=\"wp-block-group alignwide is-layout-flow wp-container-core-group-is-layout-8b1746a0 wp-block-group-is-layout-flow\">\n<div class=\"wp-block-group is-layout-flow wp-container-core-group-is-layout-1e0e26b3 wp-block-group-is-layout-flow\">\n<p class=\"is-style-nadtytul wp-block-paragraph\">Następny krok</p>\n\n\n\n<div class=\"wp-block-group is-style-cta is-style-ciemna has-krem-color has-czern-background-color has-text-color has-background is-layout-flow wp-container-core-group-is-layout-8d8f77af wp-block-group-is-layout-flow\">\n<h2 class=\"wp-block-heading\">Sprawdź, ile kosztowałaby <em>Twoja</em> strona</h2>\n\n\n\n<p class=\"wp-block-paragraph\">5 minut pytań, jednostronicowa propozycja w 48 godzin. Wypełnienie do niczego nie zobowiązuje.</p>\n\n\n\n<div class=\"wp-block-buttons is-content-justification-center is-layout-flex wp-container-core-buttons-is-layout-d6955148 wp-block-buttons-is-layout-flex\">\n<div class=\"wp-block-button ze-strzalka\"><a class=\"wp-block-button__link wp-element-button\" href=\"#ankieta\">Wyceń stronę w 5 minut</a></div>\n\n\n\n<div class=\"wp-block-button is-style-outline is-style-outline--6\"><a class=\"wp-block-button__link wp-element-button\" href=\"#rozmowa\">Wolisz porozmawiać? Umów 30 minut</a></div>\n</div>\n</div>\n</div>\n\n\n\n<div class=\"wp-block-group mp-zobacz-tez is-layout-flex wp-block-group-is-layout-flex\">\n<p class=\"wp-block-paragraph\">Zobacz też:</p>\n\n\n\n<p class=\"is-style-strzalka wp-block-paragraph\"><a href=\"/dla-kogo/biura-rachunkowe/\">Biura rachunkowe</a></p>\n\n\n\n<p class=\"is-style-strzalka wp-block-paragraph\"><a href=\"/dla-kogo/psycholodzy-i-terapeuci/\">Psycholodzy i terapeuci</a></p>\n</div>\n</div>\n</section>\n",
