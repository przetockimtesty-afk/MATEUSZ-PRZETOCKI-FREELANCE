 "content": {
  "raw": "<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"clamp(24px, 2.8vw, 40px)\",\"bottom\":\"clamp(72px, 8.4vw, 120px)\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull\" style=\"padding-top:clamp(24px, 2.8vw, 40px);padding-bottom:clamp(72px, 8.4vw, 120px)\"><!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|50\"}}} -->\n<div class=\"wp-block-group alignwide\"><!-- wp:columns {\"verticalAlignment\":\"top\",\"className\":\"mp-ankieta-uklad\",\"style\":{\"spacing\":{\"blockGap\":{\"top\":\"48px\",\"left\":\"48px\"}}}} -->\n<div class=\"wp-block-columns are-vertically-aligned-top mp-ankieta-uklad\"><!-- wp:column {\"width\":\"40%\",\"className\":\"mp-hero-tekst\"} -->\n<div class=\"wp-block-column mp-hero-tekst\" style=\"flex-basis:40%\"><!-- wp:paragraph {\"className\":\"is-style-nadtytul\"} -->\n<p class=\"is-style-nadtytul\">Dla klientów</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":1} -->\n<h1 class=\"wp-block-heading\">Odbiór <em>strony</em></h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"is-style-wstep\"} -->\n<p class=\"is-style-wstep\">Zanim strona pójdzie w świat, sprawdź ją tak, jak zrobi to Twój klient: formularze, kalendarz, dane i teksty.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list {\"className\":\"is-style-lista-znaczniki\"} -->\n<ul class=\"wp-block-list is-style-lista-znaczniki\"><!-- wp:list-item -->\n<li>Ok. 10 minut.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Po potwierdzeniu odbioru i płatności końcowej publikuję stronę.</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"width\":\"60%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:60%\"><!-- wp:mp/ankieta {\"definicja\":{\"id\":\"odbior\",\"nazwa\":\"Odbiór strony\",\"czas\":\"ok. 10 minut\",\"pola\":{\"email\":\"EMAIL\",\"nazwa\":\"FIRMA\"},\"wyslij\":\"Wyślij\",\"prywatnosc\":\"Odpowiedzi widzę tylko ja i wykorzystuję je wyłącznie do naszej współpracy. Zasady opisuję w {polityka}.\",\"dziekuje\":{\"naglowek\":\"Dziękuję!\",\"tekst\":\"Jeśli odbiór jest potwierdzony, wyślę rachunek na płatność końcową. Po wpłacie publikuję stronę i przesyłam instrukcję.\"},\"potwierdzenie\":{\"temat\":\"Odbiór strony: odpowiedzi dotarły\",\"tekst\":\"Dziękuję. Poniżej kopia Twoich odpowiedzi.\"},\"kroki\":[{\"tytul\":\"Sprawdzenie\",\"pytania\":[{\"id\":\"FIRMA\",\"typ\":\"tekst\",\"tytul\":\"Imię i nazwisko albo nazwa firmy\",\"wymagane\":true},{\"id\":\"EMAIL\",\"typ\":\"email\",\"tytul\":\"Twój e-mail\",\"wymagane\":true,\"podpowiedz\":\"imie@firma.pl\"},{\"id\":\"SPRAWDZONE\",\"typ\":\"wiele\",\"tytul\":\"Co już jest sprawdzone?\",\"wymagane\":true,\"opcje\":[{\"w\":\"Strona na telefonie\",\"t\":\"Strona na telefonie\"},{\"w\":\"Strona na komputerze\",\"t\":\"Strona na komputerze\"},{\"w\":\"Próbna rezerwacja z własnym e-mailem\",\"t\":\"Próbna rezerwacja z własnym e-mailem\"},{\"w\":\"E-mail z potwierdzeniem rezerwacji\",\"t\":\"E-mail z potwierdzeniem rezerwacji\"},{\"w\":\"Rezerwacja w Kalendarzu Google\",\"t\":\"Rezerwacja w Kalendarzu Google\"},{\"w\":\"Dane firmy w stopce\",\"t\":\"Dane firmy w stopce\"},{\"w\":\"Polityka prywatności i regulamin\",\"t\":\"Polityka prywatności i regulamin\"}]},{\"id\":\"UWAGI\",\"typ\":\"akapit\",\"tytul\":\"Uwagi przed publikacją\",\"pomoc\":\"Jeśli wszystko działa, zostaw puste.\"},{\"id\":\"ODBIOR\",\"typ\":\"jeden\",\"tytul\":\"Odbiór\",\"wymagane\":true,\"opcje\":[{\"w\":\"tak\",\"t\":\"Potwierdzam odbiór, strona może iść w świat po płatności końcowej\"},{\"w\":\"poprawki\",\"t\":\"Najpierw poprawki z uwag wyżej\"}]}]},{\"tytul\":\"Realizacje\",\"pytania\":[{\"id\":\"REALIZACJE\",\"typ\":\"jeden\",\"tytul\":\"Czy mogę pokazać Twoją stronę w moich realizacjach?\",\"wymagane\":true,\"opcje\":[{\"w\":\"Tak, z nazwą firmy\",\"t\":\"Tak, z nazwą firmy\"},{\"w\":\"Tak, bez nazwy firmy\",\"t\":\"Tak, bez nazwy firmy\"},{\"w\":\"Nie\",\"t\":\"Nie\"}]}]}]},\"ukryta\":true} /--></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->",
  "protected": false,
