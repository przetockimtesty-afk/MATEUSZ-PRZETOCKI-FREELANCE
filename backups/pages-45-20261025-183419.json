 "content": {
  "raw": "<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"clamp(24px, 2.8vw, 40px)\",\"bottom\":\"clamp(40px, 4.5vw, 64px)\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull\" style=\"padding-top:clamp(24px, 2.8vw, 40px);padding-bottom:clamp(40px, 4.5vw, 64px)\"><!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|50\"}}} -->\n<div class=\"wp-block-group alignwide\"><!-- wp:paragraph {\"className\":\"is-style-okruszki\"} -->\n<p class=\"is-style-okruszki\"><a href=\"/\">Strona główna</a> › Regulamin</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\":\"mp-hero-tekst\",\"style\":{\"spacing\":{\"blockGap\":\"22px\"}}} -->\n<div class=\"wp-block-group mp-hero-tekst\"><!-- wp:paragraph {\"className\":\"is-style-etykieta-piasek\"} -->\n<p class=\"is-style-etykieta-piasek\">Szkic do sprawdzenia przez radcę</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":1} -->\n<h1 class=\"wp-block-heading\">Regulamin</h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"is-style-wstep\"} -->\n<p class=\"is-style-wstep\">Zasady korzystania z ankiety wyceny, rezerwacji rozmowy i kontaktu e-mail na tej stronie.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"0\",\"bottom\":\"clamp(72px, 8.4vw, 120px)\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull\" style=\"padding-top:0;padding-bottom:clamp(72px, 8.4vw, 120px)\"><!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|50\"}}} -->\n<div class=\"wp-block-group alignwide\"><!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column {\"width\":\"30%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:30%\"><!-- wp:group {\"tagName\":\"nav\",\"className\":\"is-style-spis\"} -->\n<nav class=\"wp-block-group is-style-spis\"><!-- wp:paragraph -->\n<p>Spis treści</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list {\"ordered\":true} -->\n<ol class=\"wp-block-list\"><!-- wp:list-item -->\n<li><a href=\"#uslugodawca\">Usługodawca</a></li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li><a href=\"#uslugi\">Jakie usługi obejmuje</a></li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li><a href=\"#wymagania\">Wymagania techniczne</a></li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li><a href=\"#zasady\">Zasady korzystania</a></li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li><a href=\"#reklamacje\">Reklamacje</a></li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li><a href=\"#odstapienie\">Odstąpienie od umowy o stronę</a></li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li><a href=\"#koncowe\">Postanowienia końcowe</a></li>\n<!-- /wp:list-item --></ol>\n<!-- /wp:list --></nav>\n<!-- /wp:group --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"width\":\"70%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:70%\"><!-- wp:group {\"className\":\"mp-dokument\"} -->\n<div class=\"wp-block-group mp-dokument\"><!-- wp:heading {\"anchor\":\"uslugodawca\"} -->\n<h2 id=\"uslugodawca\" class=\"wp-block-heading\">1. Usługodawca</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Usługi na stronie mateuszprzetocki.pl świadczy Mateusz Przetocki, [adres zamieszkania albo do korespondencji], e-mail: kontakt@….</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"anchor\":\"uslugi\"} -->\n<h2 id=\"uslugi\" class=\"wp-block-heading\">2. Jakie usługi obejmuje</h2>\n<!-- /wp:heading -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li><strong>Ankieta wyceny:</strong> formularz, po którego wysłaniu w 48 godzin dostajesz propozycję na piśmie.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li><strong>Rezerwacja rozmowy:</strong> wybór terminu 30-minutowej rozmowy na Google Meet.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li><strong>Kontakt e-mail:</strong> odpowiedź na pytanie wysłane na kontakt@….</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:paragraph -->\n<p>Korzystanie z tych usług jest bezpłatne i do niczego nie zobowiązuje. Umowę o wykonanie strony zawieramy osobno, na piśmie, po akceptacji propozycji.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"anchor\":\"wymagania\"} -->\n<h2 id=\"wymagania\" class=\"wp-block-heading\">3. Wymagania techniczne</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Wystarczy urządzenie z dostępem do internetu, aktualna przeglądarka i adres e-mail. Do rozmowy na Google Meet potrzebujesz też mikrofonu.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"anchor\":\"zasady\"} -->\n<h2 id=\"zasady\" class=\"wp-block-heading\">4. Zasady korzystania</h2>\n<!-- /wp:heading -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li>Podajesz prawdziwe dane kontaktowe, żebym mógł odpowiedzieć.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>W formularzach nie podajesz danych wrażliwych, np. o zdrowiu.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Nie przesyłasz treści sprzecznych z prawem.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Rezerwację rozmowy możesz odwołać lub przenieść z linku w potwierdzeniu.</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:heading {\"anchor\":\"reklamacje\"} -->\n<h2 id=\"reklamacje\" class=\"wp-block-heading\">5. Reklamacje</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Reklamację dotyczącą działania ankiety albo rezerwacji wysyłasz na kontakt@…. Odpowiadam w ciągu [14] dni.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"anchor\":\"odstapienie\"} -->\n<h2 id=\"odstapienie\" class=\"wp-block-heading\">6. Odstąpienie od umowy o stronę</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Umowę o wykonanie strony zawieramy na odległość, więc konsument i jednoosobowa firma mają 14 dni na odstąpienie od niej.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>[Zasady odstąpienia, w tym przy pracach rozpoczętych na Twoją prośbę: do ustalenia z radcą.]</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"anchor\":\"koncowe\"} -->\n<h2 id=\"koncowe\" class=\"wp-block-heading\">7. Postanowienia końcowe</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Zasady przetwarzania danych opisuje <a href=\"/polityka-prywatnosci/\">polityka prywatności</a>. O zmianach regulaminu informuję na tej stronie.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"textColor\":\"grafit\"} -->\n<p class=\"has-grafit-color has-text-color\">Obowiązuje od: [data publikacji]</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->",
