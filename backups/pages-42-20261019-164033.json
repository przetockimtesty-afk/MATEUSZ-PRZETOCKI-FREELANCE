 "content": {
  "raw": "<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"clamp(24px, 2.8vw, 40px)\",\"bottom\":\"clamp(40px, 4.5vw, 64px)\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull\" style=\"padding-top:clamp(24px, 2.8vw, 40px);padding-bottom:clamp(40px, 4.5vw, 64px)\"><!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":\"clamp(32px, 3.9vw, 56px)\"}}} -->\n<div class=\"wp-block-group alignwide\"><!-- wp:paragraph {\"className\":\"is-style-okruszki\"} -->\n<p class=\"is-style-okruszki\"><a href=\"/\">Strona główna</a> › Realizacje</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\":\"mp-hero-tekst\",\"style\":{\"spacing\":{\"blockGap\":\"22px\"}}} -->\n<div class=\"wp-block-group mp-hero-tekst\"><!-- wp:paragraph {\"className\":\"is-style-nadtytul\"} -->\n<p class=\"is-style-nadtytul\">Realizacje</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":1} -->\n<h1 class=\"wp-block-heading\">Realizacje</h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"is-style-wstep\"} -->\n<p class=\"is-style-wstep\">Strony z umawianiem konsultacji, które możesz kliknąć. Demo zawsze podpisuję jako demo.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"anchor\":\"demo-a\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"16px\",\"bottom\":\"clamp(72px, 8.4vw, 120px)\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull\" id=\"demo-a\" style=\"padding-top:16px;padding-bottom:clamp(72px, 8.4vw, 120px)\"><!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":\"20px\"}}} -->\n<div class=\"wp-block-group alignwide\"><!-- wp:group {\"className\":\"is-style-karta mp-karta-demo\"} -->\n<div class=\"wp-block-group is-style-karta mp-karta-demo\"><!-- wp:columns {\"verticalAlignment\":\"center\",\"className\":\"mp-demo-a\"} -->\n<div class=\"wp-block-columns are-vertically-aligned-center mp-demo-a\"><!-- wp:column {\"width\":\"45%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:45%\"><!-- wp:paragraph {\"className\":\"is-style-etykieta-piasek\"} -->\n<p class=\"is-style-etykieta-piasek\">Projekt demonstracyjny</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"className\":\"mp-tytul-demo\"} -->\n<h2 class=\"wp-block-heading mp-tytul-demo\">Strona ekspertki kredytowej</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"textColor\":\"grafit\",\"className\":\"mp-tekst-demo\"} -->\n<p class=\"mp-tekst-demo has-grafit-color has-text-color\">Klient z polecenia szuka doradczyni wieczorem i widzi tylko numer telefonu. Na tej stronie czyta odpowiedzi, wypełnia krótki formularz wstępnej analizy i sam wybiera termin konsultacji.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\":\"mp-etykiety\",\"style\":{\"spacing\":{\"blockGap\":\"6px\"}},\"layout\":{\"type\":\"flex\"}} -->\n<div class=\"wp-block-group mp-etykiety\"><!-- wp:paragraph {\"className\":\"is-style-etykieta\"} -->\n<p class=\"is-style-etykieta\">formularz analizy</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"is-style-etykieta\"} -->\n<p class=\"is-style-etykieta\">kalendarz</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"is-style-etykieta\"} -->\n<p class=\"is-style-etykieta\">pytania i odpowiedzi</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"ze-strzalka\"} -->\n<div class=\"wp-block-button ze-strzalka\"><a class=\"wp-block-button__link wp-element-button\" href=\"#demo\">Zobacz na żywo</a></div>\n<!-- /wp:button -->\n\n<!-- wp:button {\"className\":\"is-style-outline\"} -->\n<div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"/realizacje/demo-doradca-kredytowy/\">Opis przykładu</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"width\":\"55%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:55%\"><!-- wp:image {\"id\":14,\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-full\"><img src=\"https://mateuszprzetocki.pl/wp-content/uploads/2026/10/demo-laptop-telefon.webp\" alt=\"Strona ekspertki kredytowej z dema na komputerze i na telefonie\" class=\"wp-image-14\"/></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-karta-przerywana\"} -->\n<div class=\"wp-block-group is-style-karta-przerywana\"><!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"14px 32px\"}},\"layout\":{\"type\":\"flex\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph {\"className\":\"is-style-etykieta-obrys\"} -->\n<p class=\"is-style-etykieta-obrys\">Strona klientki</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"textColor\":\"grafit\",\"className\":\"mp-rozciagnij\"} -->\n<p class=\"mp-rozciagnij has-grafit-color has-text-color\">W listopadzie powstaje pierwsza strona dla doradczyni kredytowej. Pokażę ją tutaj za jej zgodą, a po 30 dniach dodam liczby i jej opinię.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"backgroundColor\":\"piasek\",\"align\":\"full\",\"anchor\":\"wczesniej\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"clamp(72px, 8.4vw, 120px)\",\"bottom\":\"clamp(72px, 8.4vw, 120px)\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull has-piasek-background-color has-background\" id=\"wczesniej\" style=\"padding-top:clamp(72px, 8.4vw, 120px);padding-bottom:clamp(72px, 8.4vw, 120px)\"><!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":\"clamp(36px, 3.9vw, 56px)\"}}} -->\n<div class=\"wp-block-group alignwide\"><!-- wp:group {\"className\":\"mp-naglowek-sekcji\",\"style\":{\"spacing\":{\"blockGap\":\"22px\"}}} -->\n<div class=\"wp-block-group mp-naglowek-sekcji\"><!-- wp:paragraph {\"className\":\"is-style-nadtytul\"} -->\n<p class=\"is-style-nadtytul\">Wcześniejsze projekty</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Sklepy i wtyczki, które zbudowałem <em>dla siebie</em></h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"textColor\":\"grafit\"} -->\n<p class=\"has-grafit-color has-text-color\">Zanim zacząłem robić strony dla specjalistów, prowadziłem własne sklepy internetowe na WooCommerce i pisałem do nich wtyczki. To projekty własne, nie realizacje dla klientów.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"20px\"}},\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"240px\"}} -->\n<div class=\"wp-block-group\"><!-- wp:group {\"className\":\"is-style-karta mp-projekt\",\"style\":{\"spacing\":{\"blockGap\":\"16px\"}}} -->\n<div class=\"wp-block-group is-style-karta mp-projekt\"><!-- wp:image {\"id\":26,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"mp-zrzut\"} -->\n<figure class=\"wp-block-image size-full mp-zrzut\"><img src=\"https://mateuszprzetocki.pl/wp-content/uploads/2026/10/zaslepka-zrzut.webp\" alt=\"Miejsce na zrzut ekranu\" class=\"wp-image-26\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:paragraph {\"className\":\"is-style-etykieta-piasek\"} -->\n<p class=\"is-style-etykieta-piasek\">Projekt własny</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3,\"className\":\"mp-h3-maly\"} -->\n<h3 class=\"wp-block-heading mp-h3-maly\">Konfigurator statuetki z podglądem</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"textColor\":\"grafit\",\"className\":\"mp-maly-tekst\"} -->\n<p class=\"mp-maly-tekst has-grafit-color has-text-color\">Wtyczka do własnego sklepu na WooCommerce.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-karta mp-projekt\",\"style\":{\"spacing\":{\"blockGap\":\"16px\"}}} -->\n<div class=\"wp-block-group is-style-karta mp-projekt\"><!-- wp:image {\"id\":26,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"mp-zrzut\"} -->\n<figure class=\"wp-block-image size-full mp-zrzut\"><img src=\"https://mateuszprzetocki.pl/wp-content/uploads/2026/10/zaslepka-zrzut.webp\" alt=\"Miejsce na zrzut ekranu\" class=\"wp-image-26\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:paragraph {\"className\":\"is-style-etykieta-piasek\"} -->\n<p class=\"is-style-etykieta-piasek\">Projekt własny</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3,\"className\":\"mp-h3-maly\"} -->\n<h3 class=\"wp-block-heading mp-h3-maly\">Zestawy produktów</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"textColor\":\"grafit\",\"className\":\"mp-maly-tekst\"} -->\n<p class=\"mp-maly-tekst has-grafit-color has-text-color\">Wtyczka do własnego sklepu na WooCommerce.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-karta mp-projekt\",\"style\":{\"spacing\":{\"blockGap\":\"16px\"}}} -->\n<div class=\"wp-block-group is-style-karta mp-projekt\"><!-- wp:image {\"id\":26,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"mp-zrzut\"} -->\n<figure class=\"wp-block-image size-full mp-zrzut\"><img src=\"https://mateuszprzetocki.pl/wp-content/uploads/2026/10/zaslepka-zrzut.webp\" alt=\"Miejsce na zrzut ekranu\" class=\"wp-image-26\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:paragraph {\"className\":\"is-style-etykieta-piasek\"} -->\n<p class=\"is-style-etykieta-piasek\">Projekt własny</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3,\"className\":\"mp-h3-maly\"} -->\n<h3 class=\"wp-block-heading mp-h3-maly\">Stały pasek z przyciskiem zakupu</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"textColor\":\"grafit\",\"className\":\"mp-maly-tekst\"} -->\n<p class=\"mp-maly-tekst has-grafit-color has-text-color\">Wtyczka do własnego sklepu na WooCommerce.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-karta mp-projekt\",\"style\":{\"spacing\":{\"blockGap\":\"16px\"}}} -->\n<div class=\"wp-block-group is-style-karta mp-projekt\"><!-- wp:image {\"id\":26,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"mp-zrzut\"} -->\n<figure class=\"wp-block-image size-full mp-zrzut\"><img src=\"https://mateuszprzetocki.pl/wp-content/uploads/2026/10/zaslepka-zrzut.webp\" alt=\"Miejsce na zrzut ekranu\" class=\"wp-image-26\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:paragraph {\"className\":\"is-style-etykieta-piasek\"} -->\n<p class=\"is-style-etykieta-piasek\">Projekt własny</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3,\"className\":\"mp-h3-maly\"} -->\n<h3 class=\"wp-block-heading mp-h3-maly\">Pomiar skuteczności reklam</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"textColor\":\"grafit\",\"className\":\"mp-maly-tekst\"} -->\n<p class=\"mp-maly-tekst has-grafit-color has-text-color\">Piksel Meta we własnym sklepie na WooCommerce.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"anchor\":\"nastepny-krok\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"clamp(72px, 8.4vw, 120px)\",\"bottom\":\"clamp(72px, 8.4vw, 120px)\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull\" id=\"nastepny-krok\" style=\"padding-top:clamp(72px, 8.4vw, 120px);padding-bottom:clamp(72px, 8.4vw, 120px)\"><!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<div class=\"wp-block-group alignwide\"><!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"22px\"}}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph {\"className\":\"is-style-nadtytul\"} -->\n<p class=\"is-style-nadtytul\">Następny krok</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"backgroundColor\":\"czern\",\"textColor\":\"krem\",\"className\":\"is-style-cta is-style-ciemna\",\"style\":{\"spacing\":{\"blockGap\":\"20px\"}}} -->\n<div class=\"wp-block-group is-style-cta is-style-ciemna has-krem-color has-czern-background-color has-text-color has-background\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Sprawdź, ile kosztowałaby <em>Twoja</em> strona</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>5 minut pytań, jednostronicowa propozycja w 48 godzin. Wypełnienie do niczego nie zobowiązuje.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"ze-strzalka\"} -->\n<div class=\"wp-block-button ze-strzalka\"><a class=\"wp-block-button__link wp-element-button\" href=\"#ankieta\">Wyceń stronę w 5 minut</a></div>\n<!-- /wp:button -->\n\n<!-- wp:button {\"className\":\"is-style-outline\"} -->\n<div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"#rozmowa\">Wolisz porozmawiać? Umów 30 minut</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"mp-zobacz-tez\",\"layout\":{\"type\":\"flex\"}} -->\n<div class=\"wp-block-group mp-zobacz-tez\"><!-- wp:paragraph -->\n<p>Zobacz też:</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"is-style-strzalka\"} -->\n<p class=\"is-style-strzalka\"><a href=\"/realizacje/demo-doradca-kredytowy/\">Jak działa strona ekspertki kredytowej</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"is-style-strzalka\"} -->\n<p class=\"is-style-strzalka\"><a href=\"/dla-kogo/\">Strony dla Twojej branży</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->",
  "rendered": "\n<section class=\"wp-block-group alignfull has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\" style=\"padding-top:clamp(24px, 2.8vw, 40px);padding-bottom:clamp(40px, 4.5vw, 64px)\">\n<div class=\"wp-block-group alignwide is-layout-flow wp-block-group-is-layout-flow\">\n<p class=\"is-style-okruszki wp-block-paragraph\"><a href=\"/\">Strona główna</a> › Realizacje</p>\n\n\n\n<div class=\"wp-block-group mp-hero-tekst is-layout-flow wp-container-core-group-is-layout-1e0e26b3 wp-block-group-is-layout-flow\">\n<p class=\"is-style-nadtytul wp-block-paragraph\">Realizacje</p>\n\n\n\n<h1 class=\"wp-block-heading\">Realizacje</h1>\n\n\n\n<p class=\"is-style-wstep wp-block-paragraph\">Strony z umawianiem konsultacji, które możesz kliknąć. Demo zawsze podpisuję jako demo.</p>\n</div>\n</div>\n</section>\n\n\n\n<section class=\"wp-block-group alignfull has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\" id=\"demo-a\" style=\"padding-top:16px;padding-bottom:clamp(72px, 8.4vw, 120px)\">\n<div class=\"wp-block-group alignwide is-layout-flow wp-container-core-group-is-layout-8d8f77af wp-block-group-is-layout-flow\">\n<div class=\"wp-block-group is-style-karta mp-karta-demo is-layout-flow wp-block-group-is-layout-flow\">\n<div class=\"wp-block-columns are-vertically-aligned-center mp-demo-a is-layout-flex wp-container-core-columns-is-layout-a25c9dff wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\" style=\"flex-basis:45%\">\n<p class=\"is-style-etykieta-piasek wp-block-paragraph\">Projekt demonstracyjny</p>\n\n\n\n<h2 class=\"wp-block-heading mp-tytul-demo\">Strona ekspertki kredytowej</h2>\n\n\n\n<p class=\"mp-tekst-demo has-grafit-color has-text-color wp-block-paragraph\">Klient z polecenia szuka doradczyni wieczorem i widzi tylko numer telefonu. Na tej stronie czyta odpowiedzi, wypełnia krótki formularz wstępnej analizy i sam wybiera termin konsultacji.</p>\n\n\n\n<div class=\"wp-block-group mp-etykiety is-layout-flex wp-container-core-group-is-layout-e0bd8caf wp-block-group-is-layout-flex\">\n<p class=\"is-style-etykieta wp-block-paragraph\">formularz analizy</p>\n\n\n\n<p class=\"is-style-etykieta wp-block-paragraph\">kalendarz</p>\n\n\n\n<p class=\"is-style-etykieta wp-block-paragraph\">pytania i odpowiedzi</p>\n</div>\n\n\n\n<div class=\"wp-block-buttons is-layout-flex wp-block-buttons-is-layout-flex\">\n<div class=\"wp-block-button ze-strzalka\"><a class=\"wp-block-button__link wp-element-button\" href=\"#demo\">Zobacz na żywo</a></div>\n\n\n\n<div class=\"wp-block-button is-style-outline is-style-outline--3\"><a class=\"wp-block-button__link wp-element-button\" href=\"/realizacje/demo-doradca-kredytowy/\">Opis przykładu</a></div>\n</div>\n</div>\n\n\n\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\" style=\"flex-basis:55%\">\n<figure class=\"wp-block-image size-full\"><img loading=\"lazy\" decoding=\"async\" width=\"1200\" height=\"766\" src=\"https://mateuszprzetocki.pl/wp-content/uploads/2026/10/demo-laptop-telefon.webp\" alt=\"Strona ekspertki kredytowej z dema na komputerze i na telefonie\" class=\"wp-image-14\" srcset=\"https://mateuszprzetocki.pl/wp-content/uploads/2026/10/demo-laptop-telefon.webp 1200w, https://mateuszprzetocki.pl/wp-content/uploads/2026/10/demo-laptop-telefon-300x192.webp 300w, https://mateuszprzetocki.pl/wp-content/uploads/2026/10/demo-laptop-telefon-1024x654.webp 1024w, https://mateuszprzetocki.pl/wp-content/uploads/2026/10/demo-laptop-telefon-768x490.webp 768w\" sizes=\"auto, (max-width: 1200px) 100vw, 1200px\" /></figure>\n</div>\n</div>\n</div>\n\n\n\n<div class=\"wp-block-group is-style-karta-przerywana is-layout-flow wp-block-group-is-layout-flow\">\n<div class=\"wp-block-group is-layout-flex wp-container-core-group-is-layout-ec721e1e wp-block-group-is-layout-flex\">\n<p class=\"is-style-etykieta-obrys wp-block-paragraph\">Strona klientki</p>\n\n\n\n<p class=\"mp-rozciagnij has-grafit-color has-text-color wp-block-paragraph\">W listopadzie powstaje pierwsza strona dla doradczyni kredytowej. Pokażę ją tutaj za jej zgodą, a po 30 dniach dodam liczby i jej opinię.</p>\n</div>\n</div>\n</div>\n</section>\n\n\n\n<section class=\"wp-block-group alignfull has-piasek-background-color has-background has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\" id=\"wczesniej\" style=\"padding-top:clamp(72px, 8.4vw, 120px);padding-bottom:clamp(72px, 8.4vw, 120px)\">\n<div class=\"wp-block-group alignwide is-layout-flow wp-block-group-is-layout-flow\">\n<div class=\"wp-block-group mp-naglowek-sekcji is-layout-flow wp-container-core-group-is-layout-1e0e26b3 wp-block-group-is-layout-flow\">\n<p class=\"is-style-nadtytul wp-block-paragraph\">Wcześniejsze projekty</p>\n\n\n\n<h2 class=\"wp-block-heading\">Sklepy i wtyczki, które zbudowałem <em>dla siebie</em></h2>\n\n\n\n<p class=\"has-grafit-color has-text-color wp-block-paragraph\">Zanim zacząłem robić strony dla specjalistów, prowadziłem własne sklepy internetowe na WooCommerce i pisałem do nich wtyczki. To projekty własne, nie realizacje dla klientów.</p>\n</div>\n\n\n\n<div class=\"wp-block-group is-layout-grid wp-container-core-group-is-layout-3b8d9c90 wp-block-group-is-layout-grid\">\n<div class=\"wp-block-group is-style-karta mp-projekt is-layout-flow wp-container-core-group-is-layout-bbac0742 wp-block-group-is-layout-flow\">\n<figure class=\"wp-block-image size-full mp-zrzut\"><img loading=\"lazy\" decoding=\"async\" width=\"800\" height=\"500\" src=\"https://mateuszprzetocki.pl/wp-content/uploads/2026/10/zaslepka-zrzut.webp\" alt=\"Miejsce na zrzut ekranu\" class=\"wp-image-26\" srcset=\"https://mateuszprzetocki.pl/wp-content/uploads/2026/10/zaslepka-zrzut.webp 800w, https://mateuszprzetocki.pl/wp-content/uploads/2026/10/zaslepka-zrzut-300x188.webp 300w, https://mateuszprzetocki.pl/wp-content/uploads/2026/10/zaslepka-zrzut-768x480.webp 768w\" sizes=\"auto, (max-width: 800px) 100vw, 800px\" /></figure>\n\n\n\n<p class=\"is-style-etykieta-piasek wp-block-paragraph\">Projekt własny</p>\n\n\n\n<h3 class=\"wp-block-heading mp-h3-maly\">Konfigurator statuetki z podglądem</h3>\n\n\n\n<p class=\"mp-maly-tekst has-grafit-color has-text-color wp-block-paragraph\">Wtyczka do własnego sklepu na WooCommerce.</p>\n</div>\n\n\n\n<div class=\"wp-block-group is-style-karta mp-projekt is-layout-flow wp-container-core-group-is-layout-bbac0742 wp-block-group-is-layout-flow\">\n<figure class=\"wp-block-image size-full mp-zrzut\"><img loading=\"lazy\" decoding=\"async\" width=\"800\" height=\"500\" src=\"https://mateuszprzetocki.pl/wp-content/uploads/2026/10/zaslepka-zrzut.webp\" alt=\"Miejsce na zrzut ekranu\" class=\"wp-image-26\" srcset=\"https://mateuszprzetocki.pl/wp-content/uploads/2026/10/zaslepka-zrzut.webp 800w, https://mateuszprzetocki.pl/wp-content/uploads/2026/10/zaslepka-zrzut-300x188.webp 300w, https://mateuszprzetocki.pl/wp-content/uploads/2026/10/zaslepka-zrzut-768x480.webp 768w\" sizes=\"auto, (max-width: 800px) 100vw, 800px\" /></figure>\n\n\n\n<p class=\"is-style-etykieta-piasek wp-block-paragraph\">Projekt własny</p>\n\n\n\n<h3 class=\"wp-block-heading mp-h3-maly\">Zestawy produktów</h3>\n\n\n\n<p class=\"mp-maly-tekst has-grafit-color has-text-color wp-block-paragraph\">Wtyczka do własnego sklepu na WooCommerce.</p>\n</div>\n\n\n\n<div class=\"wp-block-group is-style-karta mp-projekt is-layout-flow wp-container-core-group-is-layout-bbac0742 wp-block-group-is-layout-flow\">\n<figure class=\"wp-block-image size-full mp-zrzut\"><img loading=\"lazy\" decoding=\"async\" width=\"800\" height=\"500\" src=\"https://mateuszprzetocki.pl/wp-content/uploads/2026/10/zaslepka-zrzut.webp\" alt=\"Miejsce na zrzut ekranu\" class=\"wp-image-26\" srcset=\"https://mateuszprzetocki.pl/wp-content/uploads/2026/10/zaslepka-zrzut.webp 800w, https://mateuszprzetocki.pl/wp-content/uploads/2026/10/zaslepka-zrzut-300x188.webp 300w, https://mateuszprzetocki.pl/wp-content/uploads/2026/10/zaslepka-zrzut-768x480.webp 768w\" sizes=\"auto, (max-width: 800px) 100vw, 800px\" /></figure>\n\n\n\n<p class=\"is-style-etykieta-piasek wp-block-paragraph\">Projekt własny</p>\n\n\n\n<h3 class=\"wp-block-heading mp-h3-maly\">Stały pasek z przyciskiem zakupu</h3>\n\n\n\n<p class=\"mp-maly-tekst has-grafit-color has-text-color wp-block-paragraph\">Wtyczka do własnego sklepu na WooCommerce.</p>\n</div>\n\n\n\n<div class=\"wp-block-group is-style-karta mp-projekt is-layout-flow wp-container-core-group-is-layout-bbac0742 wp-block-group-is-layout-flow\">\n<figure class=\"wp-block-image size-full mp-zrzut\"><img loading=\"lazy\" decoding=\"async\" width=\"800\" height=\"500\" src=\"https://mateuszprzetocki.pl/wp-content/uploads/2026/10/zaslepka-zrzut.webp\" alt=\"Miejsce na zrzut ekranu\" class=\"wp-image-26\" srcset=\"https://mateuszprzetocki.pl/wp-content/uploads/2026/10/zaslepka-zrzut.webp 800w, https://mateuszprzetocki.pl/wp-content/uploads/2026/10/zaslepka-zrzut-300x188.webp 300w, https://mateuszprzetocki.pl/wp-content/uploads/2026/10/zaslepka-zrzut-768x480.webp 768w\" sizes=\"auto, (max-width: 800px) 100vw, 800px\" /></figure>\n\n\n\n<p class=\"is-style-etykieta-piasek wp-block-paragraph\">Projekt własny</p>\n\n\n\n<h3 class=\"wp-block-heading mp-h3-maly\">Pomiar skuteczności reklam</h3>\n\n\n\n<p class=\"mp-maly-tekst has-grafit-color has-text-color wp-block-paragraph\">Piksel Meta we własnym sklepie na WooCommerce.</p>\n</div>\n</div>\n</div>\n</section>\n\n\n\n<section class=\"wp-block-group alignfull has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\" id=\"nastepny-krok\" style=\"padding-top:clamp(72px, 8.4vw, 120px);padding-bottom:clamp(72px, 8.4vw, 120px)\">\n<div class=\"wp-block-group alignwide is-layout-flow wp-container-core-group-is-layout-8b1746a0 wp-block-group-is-layout-flow\">\n<div class=\"wp-block-group is-layout-flow wp-container-core-group-is-layout-1e0e26b3 wp-block-group-is-layout-flow\">\n<p class=\"is-style-nadtytul wp-block-paragraph\">Następny krok</p>\n\n\n\n<div class=\"wp-block-group is-style-cta is-style-ciemna has-krem-color has-czern-background-color has-text-color has-background is-layout-flow wp-container-core-group-is-layout-8d8f77af wp-block-group-is-layout-flow\">\n<h2 class=\"wp-block-heading\">Sprawdź, ile kosztowałaby <em>Twoja</em> strona</h2>\n\n\n\n<p class=\"wp-block-paragraph\">5 minut pytań, jednostronicowa propozycja w 48 godzin. Wypełnienie do niczego nie zobowiązuje.</p>\n\n\n\n<div class=\"wp-block-buttons is-content-justification-center is-layout-flex wp-container-core-buttons-is-layout-d6955148 wp-block-buttons-is-layout-flex\">\n<div class=\"wp-block-button ze-strzalka\"><a class=\"wp-block-button__link wp-element-button\" href=\"#ankieta\">Wyceń stronę w 5 minut</a></div>\n\n\n\n<div class=\"wp-block-button is-style-outline is-style-outline--4\"><a class=\"wp-block-button__link wp-element-button\" href=\"#rozmowa\">Wolisz porozmawiać? Umów 30 minut</a></div>\n</div>\n</div>\n</div>\n\n\n\n<div class=\"wp-block-group mp-zobacz-tez is-layout-flex wp-block-group-is-layout-flex\">\n<p class=\"wp-block-paragraph\">Zobacz też:</p>\n\n\n\n<p class=\"is-style-strzalka wp-block-paragraph\"><a href=\"/realizacje/demo-doradca-kredytowy/\">Jak działa strona ekspertki kredytowej</a></p>\n\n\n\n<p class=\"is-style-strzalka wp-block-paragraph\"><a href=\"/dla-kogo/\">Strony dla Twojej branży</a></p>\n</div>\n</div>\n</section>\n",
