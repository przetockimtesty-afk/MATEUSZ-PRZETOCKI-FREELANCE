 "content": {
  "raw": "<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"clamp(24px, 2.8vw, 40px)\",\"bottom\":\"clamp(72px, 8.4vw, 120px)\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull\" style=\"padding-top:clamp(24px, 2.8vw, 40px);padding-bottom:clamp(72px, 8.4vw, 120px)\"><!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|50\"}}} -->\n<div class=\"wp-block-group alignwide\"><!-- wp:columns {\"verticalAlignment\":\"top\",\"className\":\"mp-ankieta-uklad\",\"style\":{\"spacing\":{\"blockGap\":{\"top\":\"48px\",\"left\":\"48px\"}}}} -->\n<div class=\"wp-block-columns are-vertically-aligned-top mp-ankieta-uklad\"><!-- wp:column {\"width\":\"40%\",\"className\":\"mp-hero-tekst\"} -->\n<div class=\"wp-block-column mp-hero-tekst\" style=\"flex-basis:40%\"><!-- wp:paragraph {\"className\":\"is-style-nadtytul\"} -->\n<p class=\"is-style-nadtytul\">Dla klientów</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":1} -->\n<h1 class=\"wp-block-heading\">Pierwsze 30 <em>dni</em></h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"is-style-wstep\"} -->\n<p class=\"is-style-wstep\">Minął miesiąc od startu strony. Kilka pytań o to, jak działa: liczby, opinia i co poprawić.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list {\"className\":\"is-style-lista-znaczniki\"} -->\n<ul class=\"wp-block-list is-style-lista-znaczniki\"><!-- wp:list-item -->\n<li>Ok. 5 minut.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Podsumowanie z liczbami wyślę Ci e-mailem.</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"width\":\"60%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:60%\"><!-- wp:mp/ankieta {\"definicja\":{\"id\":\"po-30-dniach\",\"nazwa\":\"Po 30 dniach\",\"czas\":\"ok. 5 minut\",\"pola\":{\"email\":\"EMAIL\",\"nazwa\":\"FIRMA\"},\"wyslij\":\"Wyślij\",\"prywatnosc\":\"Odpowiedzi widzę tylko ja i wykorzystuję je wyłącznie do naszej współpracy. Zasady opisuję w {polityka}.\",\"dziekuje\":{\"naglowek\":\"Dziękuję!\",\"tekst\":\"Twoje odpowiedzi pomagają mi robić lepsze strony. Podsumowanie z liczbami wyślę na {email}.\"},\"kroki\":[{\"tytul\":\"Liczby\",\"pytania\":[{\"id\":\"FIRMA\",\"typ\":\"tekst\",\"tytul\":\"Imię i nazwisko albo nazwa firmy\",\"wymagane\":true},{\"id\":\"EMAIL\",\"typ\":\"email\",\"tytul\":\"Twój e-mail\",\"wymagane\":true,\"podpowiedz\":\"imie@firma.pl\"},{\"id\":\"REZERWACJE\",\"typ\":\"liczba\",\"tytul\":\"Ile osób umówiło się przez stronę w pierwszych 30 dniach?\",\"podpowiedz\":\"np. 6\",\"max\":10000,\"pomoc\":\"Liczbę znajdziesz w panelu Rezerwacje.\"},{\"id\":\"KLIENCI_ZE_STRONY\",\"typ\":\"liczba\",\"tytul\":\"Ile z nich zostało klientami?\",\"podpowiedz\":\"np. 2\",\"max\":10000},{\"id\":\"TELEFONY\",\"typ\":\"jeden\",\"tytul\":\"Telefonów w trakcie pracy jest\",\"opcje\":[{\"w\":\"Mniej\",\"t\":\"Mniej\"},{\"w\":\"Tyle samo\",\"t\":\"Tyle samo\"},{\"w\":\"Więcej\",\"t\":\"Więcej\"},{\"w\":\"Trudno powiedzieć\",\"t\":\"Trudno powiedzieć\"}]}]},{\"tytul\":\"Opinia\",\"pytania\":[{\"id\":\"DZIALA\",\"typ\":\"akapit\",\"tytul\":\"Co działa najlepiej?\"},{\"id\":\"POPRAWIC\",\"typ\":\"akapit\",\"tytul\":\"Co poprawić?\"},{\"id\":\"POLECENIE\",\"typ\":\"skala\",\"tytul\":\"Jak bardzo prawdopodobne jest, że polecisz mnie znajomemu?\",\"wymagane\":true},{\"id\":\"OPINIA\",\"typ\":\"akapit\",\"tytul\":\"Opinia do pokazania na mojej stronie\",\"pomoc\":\"2–3 zdania: co było przed stroną i co się zmieniło.\"},{\"id\":\"OPINIA_ZGODA\",\"typ\":\"jeden\",\"tytul\":\"Jak podpisać opinię?\",\"gdy\":{\"OPINIA\":[\"*\"]},\"wymagane\":true,\"opcje\":[{\"w\":\"Imieniem, nazwiskiem i nazwą firmy\",\"t\":\"Imieniem, nazwiskiem i nazwą firmy\"},{\"w\":\"Samym imieniem\",\"t\":\"Samym imieniem\"},{\"w\":\"Nie publikuj\",\"t\":\"Nie publikuj\"}]},{\"id\":\"POLECENIA\",\"typ\":\"akapit\",\"tytul\":\"Kogo z Twojego otoczenia mogę zapytać o stronę?\",\"pomoc\":\"Np. 2 osoby: imię i branża. Napiszę dopiero wtedy, gdy je uprzedzisz.\"}]}]},\"ukryta\":true} /--></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->",
