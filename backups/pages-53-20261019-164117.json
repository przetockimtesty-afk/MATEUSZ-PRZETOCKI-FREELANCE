 "content": {
  "raw": "<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"clamp(24px, 2.8vw, 40px)\",\"bottom\":\"clamp(56px, 6.7vw, 96px)\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull\" style=\"padding-top:clamp(24px, 2.8vw, 40px);padding-bottom:clamp(56px, 6.7vw, 96px)\"><!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":\"clamp(32px, 3.9vw, 56px)\"}}} -->\n<div class=\"wp-block-group alignwide\"><!-- wp:paragraph {\"className\":\"is-style-okruszki\"} -->\n<p class=\"is-style-okruszki\"><a href=\"/\">Strona główna</a> › <a href=\"/dla-kogo/\">Dla kogo</a> › Psycholodzy i terapeuci</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\":\"mp-hero-tekst\",\"style\":{\"spacing\":{\"blockGap\":\"22px\"}}} -->\n<div class=\"wp-block-group mp-hero-tekst\"><!-- wp:paragraph {\"className\":\"is-style-nadtytul\"} -->\n<p class=\"is-style-nadtytul\">03 · Terapia</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":1} -->\n<h1 class=\"wp-block-heading\">Strona dla psychologa i terapeuty: wizyta bez <em>telefonu</em></h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"is-style-wstep\"} -->\n<p class=\"is-style-wstep\">Pierwszy telefon do terapeuty bywa dla klienta trudny. Spokojna strona z Twoim podejściem i kalendarzem pozwala umówić się bez rozmowy.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\":\"mp-etykiety\",\"style\":{\"spacing\":{\"blockGap\":\"6px\"}},\"layout\":{\"type\":\"flex\"}} -->\n<div class=\"wp-block-group mp-etykiety\"><!-- wp:paragraph {\"className\":\"is-style-etykieta\"} -->\n<p class=\"is-style-etykieta\">podejście i specjalizacje</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"is-style-etykieta\"} -->\n<p class=\"is-style-etykieta\">wizyty online</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"is-style-etykieta\"} -->\n<p class=\"is-style-etykieta\">kalendarz</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"ze-strzalka\"} -->\n<div class=\"wp-block-button ze-strzalka\"><a class=\"wp-block-button__link wp-element-button\" href=\"#ankieta\">Wyceń stronę w 5 minut</a></div>\n<!-- /wp:button -->\n\n<!-- wp:button {\"className\":\"is-style-outline\"} -->\n<div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"#demo\">Zobacz demo</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->\n\n<!-- wp:paragraph {\"className\":\"is-style-podpis\"} -->\n<p class=\"is-style-podpis\">Bez zobowiązań · propozycja w 48 h</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"backgroundColor\":\"piasek\",\"align\":\"full\",\"anchor\":\"problem\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"clamp(72px, 8.4vw, 120px)\",\"bottom\":\"clamp(72px, 8.4vw, 120px)\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull has-piasek-background-color has-background\" id=\"problem\" style=\"padding-top:clamp(72px, 8.4vw, 120px);padding-bottom:clamp(72px, 8.4vw, 120px)\"><!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":\"clamp(36px, 3.9vw, 56px)\"}}} -->\n<div class=\"wp-block-group alignwide\"><!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column {\"width\":\"40%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:40%\"><!-- wp:paragraph {\"className\":\"is-style-nadtytul\"} -->\n<p class=\"is-style-nadtytul\">Problem</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Najtrudniejszy jest <em>pierwszy</em> telefon</h2>\n<!-- /wp:heading --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"width\":\"60%\",\"className\":\"mp-akapity\"} -->\n<div class=\"wp-block-column mp-akapity\" style=\"flex-basis:60%\"><!-- wp:paragraph -->\n<p>Dla wielu osób zadzwonienie do terapeuty to najtrudniejszy krok. W trakcie sesji nie odbierasz, a ktoś, kto zebrał się na odwagę, nie zawsze zadzwoni drugi raz.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Na stronie może spokojnie przeczytać o Twoim podejściu i wybrać termin, kiedy jest gotowy.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"anchor\":\"co-dostajesz\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"clamp(72px, 8.4vw, 120px)\",\"bottom\":\"clamp(72px, 8.4vw, 120px)\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull\" id=\"co-dostajesz\" style=\"padding-top:clamp(72px, 8.4vw, 120px);padding-bottom:clamp(72px, 8.4vw, 120px)\"><!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":\"clamp(36px, 3.9vw, 56px)\"}}} -->\n<div class=\"wp-block-group alignwide\"><!-- wp:group {\"className\":\"mp-naglowek-sekcji\",\"style\":{\"spacing\":{\"blockGap\":\"22px\"}}} -->\n<div class=\"wp-block-group mp-naglowek-sekcji\"><!-- wp:paragraph {\"className\":\"is-style-nadtytul\"} -->\n<p class=\"is-style-nadtytul\">Co dostajesz</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Klient umawia się, kiedy jest <em>gotowy</em></h2>\n<!-- /wp:heading --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"20px\"}},\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"300px\"}} -->\n<div class=\"wp-block-group\"><!-- wp:group {\"className\":\"is-style-karta\"} -->\n<div class=\"wp-block-group is-style-karta\"><!-- wp:html -->\n<span class=\"mp-ikona\" aria-hidden=\"true\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2\"/> <circle cx=\"12\" cy=\"7\" r=\"4\"/></svg></span>\n<!-- /wp:html -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Klient czyta o Twoim podejściu i umawia się bez telefonu</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Podejście, kwalifikacje i przebieg pierwszej sesji, Twoimi słowami.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-karta\"} -->\n<div class=\"wp-block-group is-style-karta\"><!-- wp:html -->\n<span class=\"mp-ikona\" aria-hidden=\"true\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M8 2v3\"/> <path d=\"M16 2v3\"/> <rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/> <path d=\"M3 9h18\"/> <path d=\"m9 15 2 2 4-4\"/></svg></span>\n<!-- /wp:html -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Wizyty w gabinecie i online w jednym kalendarzu</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Klient wybiera formę wizyty i wolny termin.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-karta\"} -->\n<div class=\"wp-block-group is-style-karta\"><!-- wp:html -->\n<span class=\"mp-ikona\" aria-hidden=\"true\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719\"/> <path d=\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"/> <path d=\"M12 17h.01\"/></svg></span>\n<!-- /wp:html -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Odpowiedzi na pytania o pierwszą sesję, cenę i odwoływanie wizyt</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Zanim przyjdzie, wie, czego się spodziewać.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-karta\"} -->\n<div class=\"wp-block-group is-style-karta\"><!-- wp:html -->\n<span class=\"mp-ikona\" aria-hidden=\"true\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><circle cx=\"12\" cy=\"12\" r=\"10\"/> <path d=\"m16 9-5.5 5.5L8 12\"/></svg></span>\n<!-- /wp:html -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Spokojny wygląd bez natłoku informacji</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Dużo powietrza, krótkie zdania i jeden przycisk do rezerwacji.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-karta\"} -->\n<div class=\"wp-block-group is-style-karta\"><!-- wp:html -->\n<span class=\"mp-ikona\" aria-hidden=\"true\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><circle cx=\"12\" cy=\"12\" r=\"10\"/> <path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"/> <path d=\"M2 12h20\"/></svg></span>\n<!-- /wp:html -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Własny kalendarz zamiast płatnych platform</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Rezerwacje są na Twojej stronie, nie w serwisie z abonamentem.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"anchor\":\"jak-wyglada\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"0\",\"bottom\":\"clamp(72px, 8.4vw, 120px)\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull\" id=\"jak-wyglada\" style=\"padding-top:0;padding-bottom:clamp(72px, 8.4vw, 120px)\"><!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":\"clamp(36px, 3.9vw, 56px)\"}}} -->\n<div class=\"wp-block-group alignwide\"><!-- wp:group {\"className\":\"mp-naglowek-sekcji mp-srodek\",\"style\":{\"spacing\":{\"blockGap\":\"22px\"}}} -->\n<div class=\"wp-block-group mp-naglowek-sekcji mp-srodek\"><!-- wp:paragraph {\"align\":\"center\",\"className\":\"is-style-nadtytul\"} -->\n<p class=\"is-style-nadtytul\">Jak to wygląda</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Trzy ekrany, <em>żadnej</em> rozmowy</h2>\n<!-- /wp:heading --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"mp-ekrany\",\"style\":{\"spacing\":{\"blockGap\":\"32px\"}},\"layout\":{\"type\":\"flex\",\"flexWrap\":\"nowrap\",\"justifyContent\":\"center\",\"verticalAlignment\":\"top\"}} -->\n<div class=\"wp-block-group mp-ekrany\"><!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<div class=\"wp-block-group\"><!-- wp:image {\"id\":21,\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-full\"><img src=\"https://mateuszprzetocki.pl/wp-content/uploads/2026/10/terapeuci-podejscie.webp\" alt=\"Opis podejścia i specjalizacji terapeuty\" class=\"wp-image-21\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:paragraph {\"className\":\"mp-opis\"} -->\n<p class=\"mp-opis\">Czyta o Twoim podejściu</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<div class=\"wp-block-group\"><!-- wp:image {\"id\":22,\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-full\"><img src=\"https://mateuszprzetocki.pl/wp-content/uploads/2026/10/terapeuci-wizyta.webp\" alt=\"Wybór formy wizyty i terminu\" class=\"wp-image-22\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:paragraph {\"className\":\"mp-opis\"} -->\n<p class=\"mp-opis\">Wybiera gabinet albo online i wolny termin</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<div class=\"wp-block-group\"><!-- wp:image {\"id\":23,\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-full\"><img src=\"https://mateuszprzetocki.pl/wp-content/uploads/2026/10/terapeuci-potwierdzenie.webp\" alt=\"Potwierdzenie pierwszej sesji\" class=\"wp-image-23\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:paragraph {\"className\":\"mp-opis\"} -->\n<p class=\"mp-opis\">Dostaje potwierdzenie bez pytań o zdrowie</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"16px 28px\"}},\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-group\"><!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"is-style-outline ze-strzalka\"} -->\n<div class=\"wp-block-button is-style-outline ze-strzalka\"><a class=\"wp-block-button__link wp-element-button\" href=\"#demo\">Zobacz demo na żywo</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"backgroundColor\":\"piasek\",\"align\":\"full\",\"anchor\":\"przepisy\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"clamp(72px, 8.4vw, 120px)\",\"bottom\":\"clamp(72px, 8.4vw, 120px)\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull has-piasek-background-color has-background\" id=\"przepisy\" style=\"padding-top:clamp(72px, 8.4vw, 120px);padding-bottom:clamp(72px, 8.4vw, 120px)\"><!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":\"clamp(36px, 3.9vw, 56px)\"}}} -->\n<div class=\"wp-block-group alignwide\"><!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column {\"width\":\"40%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:40%\"><!-- wp:paragraph {\"className\":\"is-style-nadtytul\"} -->\n<p class=\"is-style-nadtytul\">Przepisy i zasady</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">O co dbam na stronie <em>terapeuty</em></h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"textColor\":\"grafit\"} -->\n<p class=\"has-grafit-color has-text-color\">Strona informuje o Twojej pracy i chroni prywatność klientów.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"width\":\"60%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:60%\"><!-- wp:list {\"className\":\"is-style-lista-tarcza\"} -->\n<ul class=\"wp-block-list is-style-lista-tarcza\"><!-- wp:list-item -->\n<li>Formularz bez pytań o zdrowie: to dane szczególnej kategorii w RODO, a już sama rezerwacja może je ujawniać.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Bez obietnic efektów terapii.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Opinie klientów tylko wtedy, gdy pozwala na to kodeks etyki Twojego towarzystwa.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Gabinet wpisany do rejestru podmiotów leczniczych informuje bez cech reklamy (art. 14 ustawy o działalności leczniczej).</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"anchor\":\"pakiet\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"clamp(72px, 8.4vw, 120px)\",\"bottom\":\"clamp(72px, 8.4vw, 120px)\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull\" id=\"pakiet\" style=\"padding-top:clamp(72px, 8.4vw, 120px);padding-bottom:clamp(72px, 8.4vw, 120px)\"><!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":\"clamp(36px, 3.9vw, 56px)\"}}} -->\n<div class=\"wp-block-group alignwide\"><!-- wp:columns {\"verticalAlignment\":\"center\"} -->\n<div class=\"wp-block-columns are-vertically-aligned-center\"><!-- wp:column {\"width\":\"55%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:55%\"><!-- wp:paragraph {\"className\":\"is-style-nadtytul\"} -->\n<p class=\"is-style-nadtytul\">Polecany pakiet</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Dla terapeuty: wizytówka, która <em>umawia</em></h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Kalendarz wizyt w gabinecie i online jest w nim od razu, a odpowiedzi na pytania o pierwszą sesję zastępują pierwszy telefon.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"is-style-strzalka\"} -->\n<p class=\"is-style-strzalka\"><a href=\"/oferta/\">Zobacz wszystkie pakiety</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"width\":\"45%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:45%\"><!-- wp:group {\"tagName\":\"article\",\"className\":\"is-style-pakiet-polecany\",\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<article class=\"wp-block-group is-style-pakiet-polecany\"><!-- wp:paragraph {\"className\":\"is-style-etykieta-czarna\"} -->\n<p class=\"is-style-etykieta-czarna\">Polecam</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Wizytówka, która umawia</h3>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"mp-cena\",\"layout\":{\"type\":\"flex\"}} -->\n<div class=\"wp-block-group mp-cena\"><!-- wp:paragraph -->\n<p>1 800</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>zł</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:paragraph {\"className\":\"mp-dla\"} -->\n<p class=\"mp-dla\">Gdy chcesz mniej telefonów i krótsze pierwsze rozmowy.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list {\"className\":\"is-style-lista-pakiet\"} -->\n<ul class=\"wp-block-list is-style-lista-pakiet\"><!-- wp:list-item -->\n<li>Jedna strona, 6 sekcji, wersja na telefon</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Kalendarz wizyt w gabinecie i online</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Odpowiedzi na pytania o pierwszą sesję i cenę</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Profil Firmy w Google, gdy firma spełnia wytyczne</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"ze-strzalka\"} -->\n<div class=\"wp-block-button ze-strzalka\"><a class=\"wp-block-button__link wp-element-button\" href=\"#ankieta\">Wyceń stronę w 5 minut</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></article>\n<!-- /wp:group --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"anchor\":\"pytania\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"0\",\"bottom\":\"clamp(72px, 8.4vw, 120px)\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull\" id=\"pytania\" style=\"padding-top:0;padding-bottom:clamp(72px, 8.4vw, 120px)\"><!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":\"clamp(36px, 3.9vw, 56px)\"}}} -->\n<div class=\"wp-block-group alignwide\"><!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column {\"width\":\"40%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:40%\"><!-- wp:paragraph {\"className\":\"is-style-nadtytul\"} -->\n<p class=\"is-style-nadtytul\">Pytania terapeutów</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Zanim <em>zapytasz</em></h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"is-style-strzalka\"} -->\n<p class=\"is-style-strzalka\"><a href=\"/pytania/\">Wszystkie pytania</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"width\":\"60%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:60%\"><!-- wp:group {\"className\":\"mp-pytania\",\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<div class=\"wp-block-group mp-pytania\"><!-- wp:details {\"showContent\":true,\"className\":\"is-style-pytanie\"} -->\n<details class=\"wp-block-details is-style-pytanie\" open><summary>Czy klient musi napisać, z czym przychodzi?</summary><!-- wp:paragraph -->\n<p>Nie. Formularz nie pyta o zdrowie ani o powód wizyty. Klient wybiera termin i formę wizyty, a resztę mówi na pierwszej sesji.</p>\n<!-- /wp:paragraph --></details>\n<!-- /wp:details -->\n\n<!-- wp:details {\"className\":\"is-style-pytanie\"} -->\n<details class=\"wp-block-details is-style-pytanie\"><summary>Czy mogę mieć wizyty online i w gabinecie?</summary><!-- wp:paragraph -->\n<p>Tak. Oba rodzaje wizyt są w jednym kalendarzu, a klient wybiera, który mu pasuje.</p>\n<!-- /wp:paragraph --></details>\n<!-- /wp:details -->\n\n<!-- wp:details {\"className\":\"is-style-pytanie\"} -->\n<details class=\"wp-block-details is-style-pytanie\"><summary>Czy muszę płacić za platformę rezerwacji?</summary><!-- wp:paragraph -->\n<p>Nie musisz. Kalendarz jest na Twojej stronie, a nie w serwisie z abonamentem.</p>\n<!-- /wp:paragraph --></details>\n<!-- /wp:details -->\n\n<!-- wp:details {\"className\":\"is-style-pytanie\"} -->\n<details class=\"wp-block-details is-style-pytanie\"><summary>Czy na stronie mogą być opinie klientów?</summary><!-- wp:paragraph -->\n<p>Tylko jeśli pozwala na to kodeks etyki Twojego towarzystwa. Bez tego zaufanie buduje opis podejścia i kwalifikacji.</p>\n<!-- /wp:paragraph --></details>\n<!-- /wp:details --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"anchor\":\"nastepny-krok\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"0\",\"bottom\":\"clamp(72px, 8.4vw, 120px)\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull\" id=\"nastepny-krok\" style=\"padding-top:0;padding-bottom:clamp(72px, 8.4vw, 120px)\"><!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<div class=\"wp-block-group alignwide\"><!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"22px\"}}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph {\"className\":\"is-style-nadtytul\"} -->\n<p class=\"is-style-nadtytul\">Następny krok</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"backgroundColor\":\"czern\",\"textColor\":\"krem\",\"className\":\"is-style-cta is-style-ciemna\",\"style\":{\"spacing\":{\"blockGap\":\"20px\"}}} -->\n<div class=\"wp-block-group is-style-cta is-style-ciemna has-krem-color has-czern-background-color has-text-color has-background\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Sprawdź, ile kosztowałaby <em>Twoja</em> strona</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>5 minut pytań, jednostronicowa propozycja w 48 godzin. Wypełnienie do niczego nie zobowiązuje.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"ze-strzalka\"} -->\n<div class=\"wp-block-button ze-strzalka\"><a class=\"wp-block-button__link wp-element-button\" href=\"#ankieta\">Wyceń stronę w 5 minut</a></div>\n<!-- /wp:button -->\n\n<!-- wp:button {\"className\":\"is-style-outline\"} -->\n<div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"#rozmowa\">Wolisz porozmawiać? Umów 30 minut</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"mp-zobacz-tez\",\"layout\":{\"type\":\"flex\"}} -->\n<div class=\"wp-block-group mp-zobacz-tez\"><!-- wp:paragraph -->\n<p>Zobacz też:</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"is-style-strzalka\"} -->\n<p class=\"is-style-strzalka\"><a href=\"/dla-kogo/doradcy-kredytowi/\">Doradcy kredytowi</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"is-style-strzalka\"} -->\n<p class=\"is-style-strzalka\"><a href=\"/dla-kogo/biura-rachunkowe/\">Biura rachunkowe</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->",
  "rendered": "\n<section class=\"wp-block-group alignfull has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\" style=\"padding-top:clamp(24px, 2.8vw, 40px);padding-bottom:clamp(56px, 6.7vw, 96px)\">\n<div class=\"wp-block-group alignwide is-layout-flow wp-block-group-is-layout-flow\">\n<p class=\"is-style-okruszki wp-block-paragraph\"><a href=\"/\">Strona główna</a> › <a href=\"/dla-kogo/\">Dla kogo</a> › Psycholodzy i terapeuci</p>\n\n\n\n<div class=\"wp-block-group mp-hero-tekst is-layout-flow wp-container-core-group-is-layout-1e0e26b3 wp-block-group-is-layout-flow\">\n<p class=\"is-style-nadtytul wp-block-paragraph\">03 · Terapia</p>\n\n\n\n<h1 class=\"wp-block-heading\">Strona dla psychologa i terapeuty: wizyta bez <em>telefonu</em></h1>\n\n\n\n<p class=\"is-style-wstep wp-block-paragraph\">Pierwszy telefon do terapeuty bywa dla klienta trudny. Spokojna strona z Twoim podejściem i kalendarzem pozwala umówić się bez rozmowy.</p>\n\n\n\n<div class=\"wp-block-group mp-etykiety is-layout-flex wp-container-core-group-is-layout-e0bd8caf wp-block-group-is-layout-flex\">\n<p class=\"is-style-etykieta wp-block-paragraph\">podejście i specjalizacje</p>\n\n\n\n<p class=\"is-style-etykieta wp-block-paragraph\">wizyty online</p>\n\n\n\n<p class=\"is-style-etykieta wp-block-paragraph\">kalendarz</p>\n</div>\n\n\n\n<div class=\"wp-block-buttons is-layout-flex wp-block-buttons-is-layout-flex\">\n<div class=\"wp-block-button ze-strzalka\"><a class=\"wp-block-button__link wp-element-button\" href=\"#ankieta\">Wyceń stronę w 5 minut</a></div>\n\n\n\n<div class=\"wp-block-button is-style-outline is-style-outline--4\"><a class=\"wp-block-button__link wp-element-button\" href=\"#demo\">Zobacz demo</a></div>\n</div>\n\n\n\n<p class=\"is-style-podpis wp-block-paragraph\">Bez zobowiązań · propozycja w 48 h</p>\n</div>\n</div>\n</section>\n\n\n\n<section class=\"wp-block-group alignfull has-piasek-background-color has-background has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\" id=\"problem\" style=\"padding-top:clamp(72px, 8.4vw, 120px);padding-bottom:clamp(72px, 8.4vw, 120px)\">\n<div class=\"wp-block-group alignwide is-layout-flow wp-block-group-is-layout-flow\">\n<div class=\"wp-block-columns is-layout-flex wp-container-core-columns-is-layout-a25c9dff wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\" style=\"flex-basis:40%\">\n<p class=\"is-style-nadtytul wp-block-paragraph\">Problem</p>\n\n\n\n<h2 class=\"wp-block-heading\">Najtrudniejszy jest <em>pierwszy</em> telefon</h2>\n</div>\n\n\n\n<div class=\"wp-block-column mp-akapity is-layout-flow wp-block-column-is-layout-flow\" style=\"flex-basis:60%\">\n<p class=\"wp-block-paragraph\">Dla wielu osób zadzwonienie do terapeuty to najtrudniejszy krok. W trakcie sesji nie odbierasz, a ktoś, kto zebrał się na odwagę, nie zawsze zadzwoni drugi raz.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Na stronie może spokojnie przeczytać o Twoim podejściu i wybrać termin, kiedy jest gotowy.</p>\n</div>\n</div>\n</div>\n</section>\n\n\n\n<section class=\"wp-block-group alignfull has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\" id=\"co-dostajesz\" style=\"padding-top:clamp(72px, 8.4vw, 120px);padding-bottom:clamp(72px, 8.4vw, 120px)\">\n<div class=\"wp-block-group alignwide is-layout-flow wp-block-group-is-layout-flow\">\n<div class=\"wp-block-group mp-naglowek-sekcji is-layout-flow wp-container-core-group-is-layout-1e0e26b3 wp-block-group-is-layout-flow\">\n<p class=\"is-style-nadtytul wp-block-paragraph\">Co dostajesz</p>\n\n\n\n<h2 class=\"wp-block-heading\">Klient umawia się, kiedy jest <em>gotowy</em></h2>\n</div>\n\n\n\n<div class=\"wp-block-group is-layout-grid wp-container-core-group-is-layout-6445e5f0 wp-block-group-is-layout-grid\">\n<div class=\"wp-block-group is-style-karta is-layout-flow wp-block-group-is-layout-flow\">\n<span class=\"mp-ikona\" aria-hidden=\"true\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2\"/> <circle cx=\"12\" cy=\"7\" r=\"4\"/></svg></span>\n\n\n\n<h3 class=\"wp-block-heading\">Klient czyta o Twoim podejściu i umawia się bez telefonu</h3>\n\n\n\n<p class=\"wp-block-paragraph\">Podejście, kwalifikacje i przebieg pierwszej sesji, Twoimi słowami.</p>\n</div>\n\n\n\n<div class=\"wp-block-group is-style-karta is-layout-flow wp-block-group-is-layout-flow\">\n<span class=\"mp-ikona\" aria-hidden=\"true\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M8 2v3\"/> <path d=\"M16 2v3\"/> <rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/> <path d=\"M3 9h18\"/> <path d=\"m9 15 2 2 4-4\"/></svg></span>\n\n\n\n<h3 class=\"wp-block-heading\">Wizyty w gabinecie i online w jednym kalendarzu</h3>\n\n\n\n<p class=\"wp-block-paragraph\">Klient wybiera formę wizyty i wolny termin.</p>\n</div>\n\n\n\n<div class=\"wp-block-group is-style-karta is-layout-flow wp-block-group-is-layout-flow\">\n<span class=\"mp-ikona\" aria-hidden=\"true\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719\"/> <path d=\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"/> <path d=\"M12 17h.01\"/></svg></span>\n\n\n\n<h3 class=\"wp-block-heading\">Odpowiedzi na pytania o pierwszą sesję, cenę i odwoływanie wizyt</h3>\n\n\n\n<p class=\"wp-block-paragraph\">Zanim przyjdzie, wie, czego się spodziewać.</p>\n</div>\n\n\n\n<div class=\"wp-block-group is-style-karta is-layout-flow wp-block-group-is-layout-flow\">\n<span class=\"mp-ikona\" aria-hidden=\"true\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><circle cx=\"12\" cy=\"12\" r=\"10\"/> <path d=\"m16 9-5.5 5.5L8 12\"/></svg></span>\n\n\n\n<h3 class=\"wp-block-heading\">Spokojny wygląd bez natłoku informacji</h3>\n\n\n\n<p class=\"wp-block-paragraph\">Dużo powietrza, krótkie zdania i jeden przycisk do rezerwacji.</p>\n</div>\n\n\n\n<div class=\"wp-block-group is-style-karta is-layout-flow wp-block-group-is-layout-flow\">\n<span class=\"mp-ikona\" aria-hidden=\"true\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><circle cx=\"12\" cy=\"12\" r=\"10\"/> <path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"/> <path d=\"M2 12h20\"/></svg></span>\n\n\n\n<h3 class=\"wp-block-heading\">Własny kalendarz zamiast płatnych platform</h3>\n\n\n\n<p class=\"wp-block-paragraph\">Rezerwacje są na Twojej stronie, nie w serwisie z abonamentem.</p>\n</div>\n</div>\n</div>\n</section>\n\n\n\n<section class=\"wp-block-group alignfull has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\" id=\"jak-wyglada\" style=\"padding-top:0;padding-bottom:clamp(72px, 8.4vw, 120px)\">\n<div class=\"wp-block-group alignwide is-layout-flow wp-block-group-is-layout-flow\">\n<div class=\"wp-block-group mp-naglowek-sekcji mp-srodek is-layout-flow wp-container-core-group-is-layout-1e0e26b3 wp-block-group-is-layout-flow\">\n<p class=\"is-style-nadtytul wp-block-paragraph\">Jak to wygląda</p>\n\n\n\n<h2 class=\"wp-block-heading\">Trzy ekrany, <em>żadnej</em> rozmowy</h2>\n</div>\n\n\n\n<div class=\"wp-block-group mp-ekrany is-content-justification-center is-nowrap is-layout-flex wp-container-core-group-is-layout-c5ad0073 wp-block-group-is-layout-flex\">\n<div class=\"wp-block-group is-layout-flow wp-container-core-group-is-layout-8b1746a0 wp-block-group-is-layout-flow\">\n<figure class=\"wp-block-image size-full\"><img loading=\"lazy\" decoding=\"async\" width=\"472\" height=\"960\" src=\"https://mateuszprzetocki.pl/wp-content/uploads/2026/10/terapeuci-podejscie.webp\" alt=\"Opis podejścia i specjalizacji terapeuty\" class=\"wp-image-21\" srcset=\"https://mateuszprzetocki.pl/wp-content/uploads/2026/10/terapeuci-podejscie.webp 472w, https://mateuszprzetocki.pl/wp-content/uploads/2026/10/terapeuci-podejscie-148x300.webp 148w\" sizes=\"auto, (max-width: 472px) 100vw, 472px\" /></figure>\n\n\n\n<p class=\"mp-opis wp-block-paragraph\">Czyta o Twoim podejściu</p>\n</div>\n\n\n\n<div class=\"wp-block-group is-layout-flow wp-container-core-group-is-layout-8b1746a0 wp-block-group-is-layout-flow\">\n<figure class=\"wp-block-image size-full\"><img loading=\"lazy\" decoding=\"async\" width=\"472\" height=\"960\" src=\"https://mateuszprzetocki.pl/wp-content/uploads/2026/10/terapeuci-wizyta.webp\" alt=\"Wybór formy wizyty i terminu\" class=\"wp-image-22\" srcset=\"https://mateuszprzetocki.pl/wp-content/uploads/2026/10/terapeuci-wizyta.webp 472w, https://mateuszprzetocki.pl/wp-content/uploads/2026/10/terapeuci-wizyta-148x300.webp 148w\" sizes=\"auto, (max-width: 472px) 100vw, 472px\" /></figure>\n\n\n\n<p class=\"mp-opis wp-block-paragraph\">Wybiera gabinet albo online i wolny termin</p>\n</div>\n\n\n\n<div class=\"wp-block-group is-layout-flow wp-container-core-group-is-layout-8b1746a0 wp-block-group-is-layout-flow\">\n<figure class=\"wp-block-image size-full\"><img loading=\"lazy\" decoding=\"async\" width=\"472\" height=\"960\" src=\"https://mateuszprzetocki.pl/wp-content/uploads/2026/10/terapeuci-potwierdzenie.webp\" alt=\"Potwierdzenie pierwszej sesji\" class=\"wp-image-23\" srcset=\"https://mateuszprzetocki.pl/wp-content/uploads/2026/10/terapeuci-potwierdzenie.webp 472w, https://mateuszprzetocki.pl/wp-content/uploads/2026/10/terapeuci-potwierdzenie-148x300.webp 148w\" sizes=\"auto, (max-width: 472px) 100vw, 472px\" /></figure>\n\n\n\n<p class=\"mp-opis wp-block-paragraph\">Dostaje potwierdzenie bez pytań o zdrowie</p>\n</div>\n</div>\n\n\n\n<div class=\"wp-block-group is-content-justification-center is-layout-flex wp-container-core-group-is-layout-bad974b1 wp-block-group-is-layout-flex\">\n<div class=\"wp-block-buttons is-layout-flex wp-block-buttons-is-layout-flex\">\n<div class=\"wp-block-button is-style-outline ze-strzalka is-style-outline--5\"><a class=\"wp-block-button__link wp-element-button\" href=\"#demo\">Zobacz demo na żywo</a></div>\n</div>\n</div>\n</div>\n</section>\n\n\n\n<section class=\"wp-block-group alignfull has-piasek-background-color has-background has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\" id=\"przepisy\" style=\"padding-top:clamp(72px, 8.4vw, 120px);padding-bottom:clamp(72px, 8.4vw, 120px)\">\n<div class=\"wp-block-group alignwide is-layout-flow wp-block-group-is-layout-flow\">\n<div class=\"wp-block-columns is-layout-flex wp-container-core-columns-is-layout-a25c9dff wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\" style=\"flex-basis:40%\">\n<p class=\"is-style-nadtytul wp-block-paragraph\">Przepisy i zasady</p>\n\n\n\n<h2 class=\"wp-block-heading\">O co dbam na stronie <em>terapeuty</em></h2>\n\n\n\n<p class=\"has-grafit-color has-text-color wp-block-paragraph\">Strona informuje o Twojej pracy i chroni prywatność klientów.</p>\n</div>\n\n\n\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\" style=\"flex-basis:60%\">\n<ul class=\"wp-block-list is-style-lista-tarcza\">\n<li>Formularz bez pytań o zdrowie: to dane szczególnej kategorii w RODO, a już sama rezerwacja może je ujawniać.</li>\n\n\n\n<li>Bez obietnic efektów terapii.</li>\n\n\n\n<li>Opinie klientów tylko wtedy, gdy pozwala na to kodeks etyki Twojego towarzystwa.</li>\n\n\n\n<li>Gabinet wpisany do rejestru podmiotów leczniczych informuje bez cech reklamy (art. 14 ustawy o działalności leczniczej).</li>\n</ul>\n</div>\n</div>\n</div>\n</section>\n\n\n\n<section class=\"wp-block-group alignfull has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\" id=\"pakiet\" style=\"padding-top:clamp(72px, 8.4vw, 120px);padding-bottom:clamp(72px, 8.4vw, 120px)\">\n<div class=\"wp-block-group alignwide is-layout-flow wp-block-group-is-layout-flow\">\n<div class=\"wp-block-columns are-vertically-aligned-center is-layout-flex wp-container-core-columns-is-layout-a25c9dff wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\" style=\"flex-basis:55%\">\n<p class=\"is-style-nadtytul wp-block-paragraph\">Polecany pakiet</p>\n\n\n\n<h2 class=\"wp-block-heading\">Dla terapeuty: wizytówka, która <em>umawia</em></h2>\n\n\n\n<p class=\"wp-block-paragraph\">Kalendarz wizyt w gabinecie i online jest w nim od razu, a odpowiedzi na pytania o pierwszą sesję zastępują pierwszy telefon.</p>\n\n\n\n<p class=\"is-style-strzalka wp-block-paragraph\"><a href=\"/oferta/\">Zobacz wszystkie pakiety</a></p>\n</div>\n\n\n\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\" style=\"flex-basis:45%\">\n<article class=\"wp-block-group is-style-pakiet-polecany is-layout-flow wp-container-core-group-is-layout-8b1746a0 wp-block-group-is-layout-flow\">\n<p class=\"is-style-etykieta-czarna wp-block-paragraph\">Polecam</p>\n\n\n\n<h3 class=\"wp-block-heading\">Wizytówka, która umawia</h3>\n\n\n\n<div class=\"wp-block-group mp-cena is-layout-flex wp-block-group-is-layout-flex\">\n<p class=\"wp-block-paragraph\">1 800</p>\n\n\n\n<p class=\"wp-block-paragraph\">zł</p>\n</div>\n\n\n\n<p class=\"mp-dla wp-block-paragraph\">Gdy chcesz mniej telefonów i krótsze pierwsze rozmowy.</p>\n\n\n\n<ul class=\"wp-block-list is-style-lista-pakiet\">\n<li>Jedna strona, 6 sekcji, wersja na telefon</li>\n\n\n\n<li>Kalendarz wizyt w gabinecie i online</li>\n\n\n\n<li>Odpowiedzi na pytania o pierwszą sesję i cenę</li>\n\n\n\n<li>Profil Firmy w Google, gdy firma spełnia wytyczne</li>\n</ul>\n\n\n\n<div class=\"wp-block-buttons is-layout-flex wp-block-buttons-is-layout-flex\">\n<div class=\"wp-block-button ze-strzalka\"><a class=\"wp-block-button__link wp-element-button\" href=\"#ankieta\">Wyceń stronę w 5 minut</a></div>\n</div>\n</article>\n</div>\n</div>\n</div>\n</section>\n\n\n\n<section class=\"wp-block-group alignfull has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\" id=\"pytania\" style=\"padding-top:0;padding-bottom:clamp(72px, 8.4vw, 120px)\">\n<div class=\"wp-block-group alignwide is-layout-flow wp-block-group-is-layout-flow\">\n<div class=\"wp-block-columns is-layout-flex wp-container-core-columns-is-layout-a25c9dff wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\" style=\"flex-basis:40%\">\n<p class=\"is-style-nadtytul wp-block-paragraph\">Pytania terapeutów</p>\n\n\n\n<h2 class=\"wp-block-heading\">Zanim <em>zapytasz</em></h2>\n\n\n\n<p class=\"is-style-strzalka wp-block-paragraph\"><a href=\"/pytania/\">Wszystkie pytania</a></p>\n</div>\n\n\n\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\" style=\"flex-basis:60%\">\n<div class=\"wp-block-group mp-pytania is-layout-flow wp-container-core-group-is-layout-8b1746a0 wp-block-group-is-layout-flow\">\n<details class=\"wp-block-details is-style-pytanie is-layout-flow wp-block-details-is-layout-flow\" open><summary>Czy klient musi napisać, z czym przychodzi?</summary>\n<p class=\"wp-block-paragraph\">Nie. Formularz nie pyta o zdrowie ani o powód wizyty. Klient wybiera termin i formę wizyty, a resztę mówi na pierwszej sesji.</p>\n</details>\n\n\n\n<details class=\"wp-block-details is-style-pytanie is-layout-flow wp-block-details-is-layout-flow\"><summary>Czy mogę mieć wizyty online i w gabinecie?</summary>\n<p class=\"wp-block-paragraph\">Tak. Oba rodzaje wizyt są w jednym kalendarzu, a klient wybiera, który mu pasuje.</p>\n</details>\n\n\n\n<details class=\"wp-block-details is-style-pytanie is-layout-flow wp-block-details-is-layout-flow\"><summary>Czy muszę płacić za platformę rezerwacji?</summary>\n<p class=\"wp-block-paragraph\">Nie musisz. Kalendarz jest na Twojej stronie, a nie w serwisie z abonamentem.</p>\n</details>\n\n\n\n<details class=\"wp-block-details is-style-pytanie is-layout-flow wp-block-details-is-layout-flow\"><summary>Czy na stronie mogą być opinie klientów?</summary>\n<p class=\"wp-block-paragraph\">Tylko jeśli pozwala na to kodeks etyki Twojego towarzystwa. Bez tego zaufanie buduje opis podejścia i kwalifikacji.</p>\n</details>\n</div>\n</div>\n</div>\n</div>\n</section>\n\n\n\n<section class=\"wp-block-group alignfull has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\" id=\"nastepny-krok\" style=\"padding-top:0;padding-bottom:clamp(72px, 8.4vw, 120px)\">\n<div class=\"wp-block-group alignwide is-layout-flow wp-container-core-group-is-layout-8b1746a0 wp-block-group-is-layout-flow\">\n<div class=\"wp-block-group is-layout-flow wp-container-core-group-is-layout-1e0e26b3 wp-block-group-is-layout-flow\">\n<p class=\"is-style-nadtytul wp-block-paragraph\">Następny krok</p>\n\n\n\n<div class=\"wp-block-group is-style-cta is-style-ciemna has-krem-color has-czern-background-color has-text-color has-background is-layout-flow wp-container-core-group-is-layout-8d8f77af wp-block-group-is-layout-flow\">\n<h2 class=\"wp-block-heading\">Sprawdź, ile kosztowałaby <em>Twoja</em> strona</h2>\n\n\n\n<p class=\"wp-block-paragraph\">5 minut pytań, jednostronicowa propozycja w 48 godzin. Wypełnienie do niczego nie zobowiązuje.</p>\n\n\n\n<div class=\"wp-block-buttons is-content-justification-center is-layout-flex wp-container-core-buttons-is-layout-d6955148 wp-block-buttons-is-layout-flex\">\n<div class=\"wp-block-button ze-strzalka\"><a class=\"wp-block-button__link wp-element-button\" href=\"#ankieta\">Wyceń stronę w 5 minut</a></div>\n\n\n\n<div class=\"wp-block-button is-style-outline is-style-outline--6\"><a class=\"wp-block-button__link wp-element-button\" href=\"#rozmowa\">Wolisz porozmawiać? Umów 30 minut</a></div>\n</div>\n</div>\n</div>\n\n\n\n<div class=\"wp-block-group mp-zobacz-tez is-layout-flex wp-block-group-is-layout-flex\">\n<p class=\"wp-block-paragraph\">Zobacz też:</p>\n\n\n\n<p class=\"is-style-strzalka wp-block-paragraph\"><a href=\"/dla-kogo/doradcy-kredytowi/\">Doradcy kredytowi</a></p>\n\n\n\n<p class=\"is-style-strzalka wp-block-paragraph\"><a href=\"/dla-kogo/biura-rachunkowe/\">Biura rachunkowe</a></p>\n</div>\n</div>\n</section>\n",
