  "raw": "<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"clamp(24px, 2.8vw, 40px)\",\"bottom\":\"clamp(40px, 4.5vw, 64px)\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull\" style=\"padding-top:clamp(24px, 2.8vw, 40px);padding-bottom:clamp(40px, 4.5vw, 64px)\"><!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|50\"}}} -->\n<div class=\"wp-block-group alignwide\"><!-- wp:paragraph {\"className\":\"is-style-okruszki\"} -->\n<p class=\"is-style-okruszki\"><a href=\"/\">Strona główna</a> › Kontakt</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\":\"mp-hero-tekst\",\"style\":{\"spacing\":{\"blockGap\":\"22px\"}}} -->\n<div class=\"wp-block-group mp-hero-tekst\"><!-- wp:paragraph {\"className\":\"is-style-nadtytul\"} -->\n<p class=\"is-style-nadtytul\">Kontakt</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":1} -->\n<h1 class=\"wp-block-heading\">Kontakt</h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"is-style-wstep\"} -->\n<p class=\"is-style-wstep\">Najszybciej przez ankietę. Wolisz rozmowę albo e-mail? Też dobrze.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"anchor\":\"drogi\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"16px\",\"bottom\":\"0\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull\" id=\"drogi\" style=\"padding-top:16px;padding-bottom:0\"><!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|50\"}}} -->\n<div class=\"wp-block-group alignwide\"><!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column {\"width\":\"55%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:55%\"><!-- wp:group {\"className\":\"is-style-karta-ankieta\"} -->\n<div class=\"wp-block-group is-style-karta-ankieta\"><!-- wp:group {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group\"><!-- wp:html -->\n<span class=\"mp-ikona\" aria-hidden=\"true\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><rect width=\"8\" height=\"4\" x=\"8\" y=\"2\" rx=\"1\" ry=\"1\"/> <path d=\"M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2\"/> <path d=\"M12 11h4\"/> <path d=\"M12 16h4\"/> <path d=\"M8 11h.01\"/> <path d=\"M8 16h.01\"/></svg></span>\n<!-- /wp:html -->\n\n<!-- wp:paragraph {\"className\":\"is-style-etykieta-czarna\"} -->\n<p class=\"is-style-etykieta-czarna\">Najszybciej</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:heading {\"className\":\"mp-h2-sredni\"} -->\n<h2 class=\"wp-block-heading mp-h2-sredni\">Ankieta, 5 <em>minut</em></h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Odpowiadasz na kilka pytań o firmę i klientów. W 48 godzin dostajesz na piśmie propozycję: pakiet, łączną kwotę i termin.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list {\"className\":\"is-style-lista-znaczniki mp-lista-mala\"} -->\n<ul class=\"wp-block-list is-style-lista-znaczniki mp-lista-mala\"><!-- wp:list-item -->\n<li>Bez telefonu i bez zobowiązań</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Propozycja na piśmie w 48 h</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Odpowiadam osobiście</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"ze-strzalka\"} -->\n<div class=\"wp-block-button ze-strzalka\"><a class=\"wp-block-button__link wp-element-button\" href=\"#ankieta\">Wyceń stronę w 5 minut</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->\n\n<!-- wp:paragraph {\"className\":\"is-style-podpis\"} -->\n<p class=\"is-style-podpis\">Bez zobowiązań · propozycja w 48 h</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"width\":\"45%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:45%\"><!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"20px\"}}} -->\n<div class=\"wp-block-group\"><!-- wp:group {\"className\":\"is-style-karta\"} -->\n<div class=\"wp-block-group is-style-karta\"><!-- wp:html -->\n<span class=\"mp-ikona\" aria-hidden=\"true\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"m16 13 5.223 3.482a.5.5 0 0 0 .777-.416V7.87a.5.5 0 0 0-.752-.432L16 10.5\"/> <rect x=\"2\" y=\"6\" width=\"14\" height=\"12\" rx=\"2\"/></svg></span>\n<!-- /wp:html -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Rozmowa 30 minut na Google Meet</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Wybierasz wolny termin w moim kalendarzu. Strona rezerwacji otworzy się w nowej karcie.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"is-style-outline\"} -->\n<div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"#rozmowa\">Umów 30 minut</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-karta\"} -->\n<div class=\"wp-block-group is-style-karta\"><!-- wp:html -->\n<span class=\"mp-ikona\" aria-hidden=\"true\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7\"/> <rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\"/></svg></span>\n<!-- /wp:html -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">E-mail</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Odpowiadam w ciągu dnia roboczego.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"is-style-strzalka\"} -->\n<p class=\"is-style-strzalka\"><a href=\"#email\">kontakt@…</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"anchor\":\"dane\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"clamp(56px, 6.7vw, 96px)\",\"bottom\":\"clamp(72px, 8.4vw, 120px)\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull\" id=\"dane\" style=\"padding-top:clamp(56px, 6.7vw, 96px);padding-bottom:clamp(72px, 8.4vw, 120px)\"><!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|50\"}}} -->\n<div class=\"wp-block-group alignwide\"><!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column {\"width\":\"40%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:40%\"><!-- wp:paragraph {\"className\":\"is-style-nadtytul\"} -->\n<p class=\"is-style-nadtytul\">Dane usługodawcy</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"textColor\":\"grafit\",\"className\":\"mp-maly-tekst\"} -->\n<p class=\"mp-maly-tekst has-grafit-color has-text-color\">Nie podaję numeru telefonu: wszystko ustalamy na piśmie, a jeśli wolisz rozmowę, umówisz ją w kalendarzu.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"width\":\"60%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:60%\"><!-- wp:list {\"className\":\"is-style-lista-dane\"} -->\n<ul class=\"wp-block-list is-style-lista-dane\"><!-- wp:list-item -->\n<li><strong>Imię i nazwisko</strong> Mateusz Przetocki</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li><strong>Adres</stron