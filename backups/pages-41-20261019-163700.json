 "content": {
  "raw": "<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"clamp(24px, 2.8vw, 40px)\",\"bottom\":\"clamp(40px, 4.5vw, 64px)\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull\" style=\"padding-top:clamp(24px, 2.8vw, 40px);padding-bottom:clamp(40px, 4.5vw, 64px)\"><!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":\"clamp(32px, 3.9vw, 56px)\"}}} -->\n<div class=\"wp-block-group alignwide\"><!-- wp:paragraph {\"className\":\"is-style-okruszki\"} -->\n<p class=\"is-style-okruszki\"><a href=\"/\">Strona główna</a> › Oferta</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\":\"mp-hero-tekst\",\"style\":{\"spacing\":{\"blockGap\":\"22px\"}}} -->\n<div class=\"wp-block-group mp-hero-tekst\"><!-- wp:paragraph {\"className\":\"is-style-nadtytul\"} -->\n<p class=\"is-style-nadtytul\">Oferta</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":1} -->\n<h1 class=\"wp-block-heading\">Pakiety i <em>ceny</em></h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"is-style-wstep\"} -->\n<p class=\"is-style-wstep\">Trzy pakiety ze stałą ceną. W 48 godzin od ankiety dostajesz na piśmie propozycję: pakiet, ewentualne dodatki, łączną kwotę i termin.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"anchor\":\"pakiety\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"16px\",\"bottom\":\"clamp(72px, 8.4vw, 120px)\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull\" id=\"pakiety\" style=\"padding-top:16px;padding-bottom:clamp(72px, 8.4vw, 120px)\"><!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":\"30px\"}}} -->\n<div class=\"wp-block-group alignwide\"><!-- wp:group {\"className\":\"mp-pakiety\",\"style\":{\"spacing\":{\"blockGap\":\"20px\"}},\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"300px\"}} -->\n<div class=\"wp-block-group mp-pakiety\"><!-- wp:group {\"tagName\":\"article\",\"className\":\"is-style-pakiet\",\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<article class=\"wp-block-group is-style-pakiet\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Wizytówka</h3>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"mp-cena\",\"layout\":{\"type\":\"flex\"}} -->\n<div class=\"wp-block-group mp-cena\"><!-- wp:paragraph -->\n<p>1 200</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>zł</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:paragraph {\"className\":\"mp-dla\"} -->\n<p class=\"mp-dla\">Gdy wystarczy, że klient Cię znajdzie i napisze.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list {\"className\":\"is-style-lista-pakiet\"} -->\n<ul class=\"wp-block-list is-style-lista-pakiet\"><!-- wp:list-item -->\n<li>Jedna strona, 6 sekcji, wersja na telefon</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Formularz z potwierdzeniem dla klienta</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Treści napisane na podstawie ankiety</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Podstawy SEO, polityka prywatności, informacje formalne</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Gotowa w ok. 2 tygodnie od otrzymania materiałów</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"is-style-outline\"} -->\n<div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"#ankieta\">Wyceń stronę w 5 minut</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></article>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"article\",\"className\":\"is-style-pakiet-polecany\",\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<article class=\"wp-block-group is-style-pakiet-polecany\"><!-- wp:paragraph {\"className\":\"is-style-etykieta-czarna\"} -->\n<p class=\"is-style-etykieta-czarna\">Polecam</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Wizytówka, która umawia</h3>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"mp-cena\",\"layout\":{\"type\":\"flex\"}} -->\n<div class=\"wp-block-group mp-cena\"><!-- wp:paragraph -->\n<p>1 800</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>zł</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:paragraph {\"className\":\"mp-dla\"} -->\n<p class=\"mp-dla\">Gdy chcesz mniej telefonów i krótsze pierwsze rozmowy.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list {\"className\":\"is-style-lista-pakiet\"} -->\n<ul class=\"wp-block-list is-style-lista-pakiet\"><!-- wp:list-item {\"className\":\"mp-plus\"} -->\n<li class=\"mp-plus\">Wszystko z poprzedniego pakietu, plus:</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Formularz wstępnych pytań i kalendarz konsultacji</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Odpowiedzi na najczęstsze pytania i miejsce na opinie</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Profil Firmy w Google, gdy firma spełnia wytyczne</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"ze-strzalka\"} -->\n<div class=\"wp-block-button ze-strzalka\"><a class=\"wp-block-button__link wp-element-button\" href=\"#ankieta\">Wyceń stronę w 5 minut</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></article>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"article\",\"className\":\"is-style-pakiet\",\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<article class=\"wp-block-group is-style-pakiet\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Pełny start</h3>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"mp-cena\",\"layout\":{\"type\":\"flex\"}} -->\n<div class=\"wp-block-group mp-cena\"><!-- wp:paragraph -->\n<p>2 500</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>zł</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:paragraph {\"className\":\"mp-dla\"} -->\n<p class=\"mp-dla\">Gdy chcesz od razu zbierać opinie i kontakty.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list {\"className\":\"is-style-lista-pakiet\"} -->\n<ul class=\"wp-block-list is-style-lista-pakiet\"><!-- wp:list-item {\"className\":\"mp-plus\"} -->\n<li class=\"mp-plus\">Wszystko z poprzedniego pakietu, plus:</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Film powitalny 60 s i poradnik PDF dla klientów</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>System próśb o opinie: karta z kodem QR, SMS, e-mail</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"is-style-outline\"} -->\n<div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"#ankieta\">Wyceń stronę w 5 minut</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></article>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:paragraph {\"className\":\"mp-przypis-tekst\"} -->\n<p class=\"mp-przypis-tekst\">Domena i hosting na Ciebie: pierwszy rok ok. 55–75 zł netto, potem ok. 320–370 zł netto rocznie. Ceny pakietów są stałe, a łączną kwotę z dodatkami podaję w propozycji.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"backgroundColor\":\"piasek\",\"align\":\"full\",\"anchor\":\"porownanie\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"clamp(72px, 8.4vw, 120px)\",\"bottom\":\"clamp(72px, 8.4vw, 120px)\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull has-piasek-background-color has-background\" id=\"porownanie\" style=\"padding-top:clamp(72px, 8.4vw, 120px);padding-bottom:clamp(72px, 8.4vw, 120px)\"><!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":\"clamp(36px, 3.9vw, 56px)\"}}} -->\n<div class=\"wp-block-group alignwide\"><!-- wp:group {\"className\":\"mp-naglowek-sekcji\",\"style\":{\"spacing\":{\"blockGap\":\"22px\"}}} -->\n<div class=\"wp-block-group mp-naglowek-sekcji\"><!-- wp:paragraph {\"className\":\"is-style-nadtytul\"} -->\n<p class=\"is-style-nadtytul\">Porównanie</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Co jest w <em>każdym</em> pakiecie</h2>\n<!-- /wp:heading --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"14px\"}}} -->\n<div class=\"wp-block-group\"><!-- wp:table {\"hasFixedLayout\":false,\"className\":\"is-style-porownanie\"} -->\n<figure class=\"wp-block-table is-style-porownanie\"><table><thead><tr><th scope=\"col\">Pakiet</th><th scope=\"col\">Wizytówka</th><th scope=\"col\">Wizytówka, która umawia</th><th scope=\"col\">Pełny start</th></tr></thead><tbody><tr><th scope=\"row\">Cena</th><td>1&nbsp;200&nbsp;zł</td><td>1&nbsp;800&nbsp;zł</td><td>2&nbsp;500&nbsp;zł</td></tr><tr><th scope=\"row\">Dla kogo</th><td>Gdy wystarczy, że klient Cię znajdzie i&nbsp;napisze</td><td>Gdy chcesz mniej telefonów i&nbsp;krótsze pierwsze rozmowy</td><td>Gdy chcesz od razu zbierać opinie i&nbsp;kontakty</td></tr><tr><th scope=\"row\">Strona</th><td>Jedna strona, 6&nbsp;sekcji, wersja na telefon</td><td>To samo</td><td>To samo</td></tr><tr><th scope=\"row\">Kontakt</th><td>Formularz z&nbsp;potwierdzeniem dla klienta</td><td>Formularz wstępnych pytań i&nbsp;kalendarz konsultacji</td><td>To samo</td></tr><tr><th scope=\"row\">Treści</th><td>Napisane na podstawie ankiety</td><td>Plus odpowiedzi na najczęstsze pytania i&nbsp;miejsce na opinie</td><td>Plus film powitalny 60&nbsp;s i&nbsp;poradnik PDF dla klientów</td></tr><tr><th scope=\"row\">Google</th><td>Podstawy SEO, polityka prywatności, informacje formalne</td><td>Plus Profil Firmy w&nbsp;Google, gdy firma spełnia wytyczne</td><td>Plus system próśb o&nbsp;opinie (karta z&nbsp;kodem QR, SMS, e-mail)</td></tr><tr><th scope=\"row\">Termin</th><td>Ok.&nbsp;2&nbsp;tygodnie od otrzymania materiałów</td><td>To samo</td><td>To samo</td></tr></tbody></table><figcaption class=\"wp-element-caption\">Porównanie trzech pakietów</figcaption></figure>\n<!-- /wp:table -->\n\n<!-- wp:paragraph {\"className\":\"is-style-podpis\"} -->\n<p class=\"is-style-podpis\">Na telefonie tabelę przesuwasz palcem w bok.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"anchor\":\"masz-strone\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"clamp(72px, 8.4vw, 120px)\",\"bottom\":\"0\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull\" id=\"masz-strone\" style=\"padding-top:clamp(72px, 8.4vw, 120px);padding-bottom:0\"><!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":\"clamp(36px, 3.9vw, 56px)\"}}} -->\n<div class=\"wp-block-group alignwide\"><!-- wp:group {\"className\":\"is-style-karta\"} -->\n<div class=\"wp-block-group is-style-karta\"><!-- wp:group {\"className\":\"mp-masz-strone\",\"style\":{\"spacing\":{\"blockGap\":\"24px 48px\"}},\"layout\":{\"type\":\"flex\"}} -->\n<div class=\"wp-block-group mp-masz-strone\"><!-- wp:html /-->\n\n<!-- wp:group {\"className\":\"mp-rozciagnij\",\"style\":{\"spacing\":{\"blockGap\":\"8px\"}}} -->\n<div class=\"wp-block-group mp-rozciagnij\"><!-- wp:heading {\"className\":\"mp-h2-maly\"} -->\n<h2 class=\"wp-block-heading mp-h2-maly\">Masz już stronę?</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"textColor\":\"grafit\"} -->\n<p class=\"has-grafit-color has-text-color\">Kalendarz konsultacji i formularz wstępnych pytań dodam do Twojej obecnej strony, w jej stylu.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"12px\"}}} -->\n<div class=\"wp-block-group\"><!-- wp:group {\"className\":\"mp-od\",\"layout\":{\"type\":\"flex\",\"flexWrap\":\"nowrap\"}} -->\n<div class=\"wp-block-group mp-od\"><!-- wp:paragraph -->\n<p>od</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>800</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>zł</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:paragraph {\"className\":\"is-style-strzalka\"} -->\n<p class=\"is-style-strzalka\"><a href=\"/kontakt/\">Napisz, jaką masz stronę</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"anchor\":\"dodatki\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"clamp(72px, 8.4vw, 120px)\",\"bottom\":\"clamp(72px, 8.4vw, 120px)\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull\" id=\"dodatki\" style=\"padding-top:clamp(72px, 8.4vw, 120px);padding-bottom:clamp(72px, 8.4vw, 120px)\"><!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":\"clamp(36px, 3.9vw, 56px)\"}}} -->\n<div class=\"wp-block-group alignwide\"><!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column {\"width\":\"40%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:40%\"><!-- wp:paragraph {\"className\":\"is-style-nadtytul\"} -->\n<p class=\"is-style-nadtytul\">Dodatki</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Dodatki, gdy ich <em>potrzebujesz</em></h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"textColor\":\"grafit\"} -->\n<p class=\"has-grafit-color has-text-color\">Do każdego pakietu. Podaję ceny „od”, a dokładną kwotę dostajesz w propozycji po ankiecie.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"width\":\"60%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:60%\"><!-- wp:list {\"className\":\"is-style-lista-cennik\"} -->\n<ul class=\"wp-block-list is-style-lista-cennik\"><!-- wp:list-item -->\n<li>Profil Firmy w Google: założenie albo porządki <strong>od 300 zł</strong></li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>System próśb o opinie: karta z kodem QR, SMS i e-mail <strong>od 250 zł</strong></li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Film powitalny 60 s: scenariusz, nagranie, montaż <strong>od 400 zł</strong></li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Poradnik PDF dla Twoich klientów (treść merytoryczna od Ciebie) <strong>od 300 zł</strong></li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Proste logo, tylko razem ze stroną <strong>od 400 zł</strong></li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Statystyki odwiedzin z oknem zgód na cookies <strong>od 600 zł</strong></li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"backgroundColor\":\"piasek\",\"align\":\"full\",\"anchor\":\"warunki\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"clamp(72px, 8.4vw, 120px)\",\"bottom\":\"clamp(72px, 8.4vw, 120px)\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull has-piasek-background-color has-background\" id=\"warunki\" style=\"padding-top:clamp(72px, 8.4vw, 120px);padding-bottom:clamp(72px, 8.4vw, 120px)\"><!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":\"clamp(36px, 3.9vw, 56px)\"}}} -->\n<div class=\"wp-block-group alignwide\"><!-- wp:group {\"className\":\"mp-naglowek-sekcji\",\"style\":{\"spacing\":{\"blockGap\":\"22px\"}}} -->\n<div class=\"wp-block-group mp-naglowek-sekcji\"><!-- wp:paragraph {\"className\":\"is-style-nadtytul\"} -->\n<p class=\"is-style-nadtytul\">Warunki</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Wszystko jest na <em>piśmie</em></h2>\n<!-- /wp:heading --></div>\n<!-- /wp:group -->\n\n<!-- wp:list {\"className\":\"is-style-lista-znaczniki mp-kolumny\"} -->\n<ul class=\"wp-block-list is-style-lista-znaczniki mp-kolumny\"><!-- wp:list-item -->\n<li>Zadatek 40%, reszta przed publikacją. Dwie rundy poprawek.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Prawa autorskie do treści i grafik, które dla Ciebie tworzę, przechodzą na Ciebie po pełnej zapłacie, na podstawie umowy na piśmie. Zdjęcia z banków zdjęć, czcionki i wtyczki mają własne licencje.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>30 dni wsparcia po starcie. Potem drobne zmiany na zlecenie, wyceniane przed pracą.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Faktura bez VAT (działalność nierejestrowana) albo faktura VAT przez Useme, wtedy cena + 23% VAT.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Domena i hosting na Ciebie, płatne u dostawcy: pierwszy rok ok. 55–75 zł netto, potem ok. 320–370 zł netto rocznie (z VAT ok. 68–92 zł i ok. 394–455 zł).</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Propozycja jest ważna 14 dni.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Umowę zawieramy na odległość, więc konsument i jednoosobowa firma mają 14 dni na odstąpienie; zasady są w <a href=\"/regulamin/\">regulaminie</a>.</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"anchor\":\"nastepny-krok\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"clamp(72px, 8.4vw, 120px)\",\"bottom\":\"clamp(72px, 8.4vw, 120px)\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull\" id=\"nastepny-krok\" style=\"padding-top:clamp(72px, 8.4vw, 120px);padding-bottom:clamp(72px, 8.4vw, 120px)\"><!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<div class=\"wp-block-group alignwide\"><!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"22px\"}}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph {\"className\":\"is-style-nadtytul\"} -->\n<p class=\"is-style-nadtytul\">Następny krok</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"backgroundColor\":\"czern\",\"textColor\":\"krem\",\"className\":\"is-style-cta is-style-ciemna\",\"style\":{\"spacing\":{\"blockGap\":\"20px\"}}} -->\n<div class=\"wp-block-group is-style-cta is-style-ciemna has-krem-color has-czern-background-color has-text-color has-background\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Sprawdź, ile kosztowałaby <em>Twoja</em> strona</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>5 minut pytań, jednostronicowa propozycja w 48 godzin. Wypełnienie do niczego nie zobowiązuje.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"ze-strzalka\"} -->\n<div class=\"wp-block-button ze-strzalka\"><a class=\"wp-block-button__link wp-element-button\" href=\"#ankieta\">Wyceń stronę w 5 minut</a></div>\n<!-- /wp:button -->\n\n<!-- wp:button {\"className\":\"is-style-outline\"} -->\n<div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"#rozmowa\">Wolisz porozmawiać? Umów 30 minut</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"mp-zobacz-tez\",\"layout\":{\"type\":\"flex\"}} -->\n<div class=\"wp-block-group mp-zobacz-tez\"><!-- wp:paragraph -->\n<p>Zobacz też:</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"is-style-strzalka\"} -->\n<p class=\"is-style-strzalka\"><a href=\"/jak-pracuje/\">Jak pracuję</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"is-style-strzalka\"} -->\n<p class=\"is-style-strzalka\"><a href=\"/pytania/\">Pytania o cenę i warunki</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->",
  "rendered": "\n<section class=\"wp-block-group alignfull has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\" style=\"padding-top:clamp(24px, 2.8vw, 40px);padding-bottom:clamp(40px, 4.5vw, 64px)\">\n<div class=\"wp-block-group alignwide is-layout-flow wp-block-group-is-layout-flow\">\n<p class=\"is-style-okruszki wp-block-paragraph\"><a href=\"/\">Strona główna</a> › Oferta</p>\n\n\n\n<div class=\"wp-block-group mp-hero-tekst is-layout-flow wp-container-core-group-is-layout-1e0e26b3 wp-block-group-is-layout-flow\">\n<p class=\"is-style-nadtytul wp-block-paragraph\">Oferta</p>\n\n\n\n<h1 class=\"wp-block-heading\">Pakiety i <em>ceny</em></h1>\n\n\n\n<p class=\"is-style-wstep wp-block-paragraph\">Trzy pakiety ze stałą ceną. W 48 godzin od ankiety dostajesz na piśmie propozycję: pakiet, ewentualne dodatki, łączną kwotę i termin.</p>\n</div>\n</div>\n</section>\n\n\n\n<section class=\"wp-block-group alignfull has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\" id=\"pakiety\" style=\"padding-top:16px;padding-bottom:clamp(72px, 8.4vw, 120px)\">\n<div class=\"wp-block-group alignwide is-layout-flow wp-container-core-group-is-layout-4643573f wp-block-group-is-layout-flow\">\n<div class=\"wp-block-group mp-pakiety is-layout-grid wp-container-core-group-is-layout-6445e5f0 wp-block-group-is-layout-grid\">\n<article class=\"wp-block-group is-style-pakiet is-layout-flow wp-container-core-group-is-layout-8b1746a0 wp-block-group-is-layout-flow\">\n<h3 class=\"wp-block-heading\">Wizytówka</h3>\n\n\n\n<div class=\"wp-block-group mp-cena is-layout-flex wp-block-group-is-layout-flex\">\n<p class=\"wp-block-paragraph\">1 200</p>\n\n\n\n<p class=\"wp-block-paragraph\">zł</p>\n</div>\n\n\n\n<p class=\"mp-dla wp-block-paragraph\">Gdy wystarczy, że klient Cię znajdzie i napisze.</p>\n\n\n\n<ul class=\"wp-block-list is-style-lista-pakiet\">\n<li>Jedna strona, 6 sekcji, wersja na telefon</li>\n\n\n\n<li>Formularz z potwierdzeniem dla klienta</li>\n\n\n\n<li>Treści napisane na podstawie ankiety</li>\n\n\n\n<li>Podstawy SEO, polityka prywatności, informacje formalne</li>\n\n\n\n<li>Gotowa w ok. 2 tygodnie od otrzymania materiałów</li>\n</ul>\n\n\n\n<div class=\"wp-block-buttons is-layout-flex wp-block-buttons-is-layout-flex\">\n<div class=\"wp-block-button is-style-outline is-style-outline--4\"><a class=\"wp-block-button__link wp-element-button\" href=\"#ankieta\">Wyceń stronę w 5 minut</a></div>\n</div>\n</article>\n\n\n\n<article class=\"wp-block-group is-style-pakiet-polecany is-layout-flow wp-container-core-group-is-layout-8b1746a0 wp-block-group-is-layout-flow\">\n<p class=\"is-style-etykieta-czarna wp-block-paragraph\">Polecam</p>\n\n\n\n<h3 class=\"wp-block-heading\">Wizytówka, która umawia</h3>\n\n\n\n<div class=\"wp-block-group mp-cena is-layout-flex wp-block-group-is-layout-flex\">\n<p class=\"wp-block-paragraph\">1 800</p>\n\n\n\n<p class=\"wp-block-paragraph\">zł</p>\n</div>\n\n\n\n<p class=\"mp-dla wp-block-paragraph\">Gdy chcesz mniej telefonów i krótsze pierwsze rozmowy.</p>\n\n\n\n<ul class=\"wp-block-list is-style-lista-pakiet\">\n<li class=\"mp-plus\">Wszystko z poprzedniego pakietu, plus:</li>\n\n\n\n<li>Formularz wstępnych pytań i kalendarz konsultacji</li>\n\n\n\n<li>Odpowiedzi na najczęstsze pytania i miejsce na opinie</li>\n\n\n\n<li>Profil Firmy w Google, gdy firma spełnia wytyczne</li>\n</ul>\n\n\n\n<div class=\"wp-block-buttons is-layout-flex wp-block-buttons-is-layout-flex\">\n<div class=\"wp-block-button ze-strzalka\"><a class=\"wp-block-button__link wp-element-button\" href=\"#ankieta\">Wyceń stronę w 5 minut</a></div>\n</div>\n</article>\n\n\n\n<article class=\"wp-block-group is-style-pakiet is-layout-flow wp-container-core-group-is-layout-8b1746a0 wp-block-group-is-layout-flow\">\n<h3 class=\"wp-block-heading\">Pełny start</h3>\n\n\n\n<div class=\"wp-block-group mp-cena is-layout-flex wp-block-group-is-layout-flex\">\n<p class=\"wp-block-paragraph\">2 500</p>\n\n\n\n<p class=\"wp-block-paragraph\">zł</p>\n</div>\n\n\n\n<p class=\"mp-dla wp-block-paragraph\">Gdy chcesz od razu zbierać opinie i kontakty.</p>\n\n\n\n<ul class=\"wp-block-list is-style-lista-pakiet\">\n<li class=\"mp-plus\">Wszystko z poprzedniego pakietu, plus:</li>\n\n\n\n<li>Film powitalny 60 s i poradnik PDF dla klientów</li>\n\n\n\n<li>System próśb o opinie: karta z kodem QR, SMS, e-mail</li>\n</ul>\n\n\n\n<div class=\"wp-block-buttons is-layout-flex wp-block-buttons-is-layout-flex\">\n<div class=\"wp-block-button is-style-outline is-style-outline--5\"><a class=\"wp-block-button__link wp-element-button\" href=\"#ankieta\">Wyceń stronę w 5 minut</a></div>\n</div>\n</article>\n</div>\n\n\n\n<p class=\"mp-przypis-tekst wp-block-paragraph\">Domena i hosting na Ciebie: pierwszy rok ok. 55–75 zł netto, potem ok. 320–370 zł netto rocznie. Ceny pakietów są stałe, a łączną kwotę z dodatkami podaję w propozycji.</p>\n</div>\n</section>\n\n\n\n<section class=\"wp-block-group alignfull has-piasek-background-color has-background has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\" id=\"porownanie\" style=\"padding-top:clamp(72px, 8.4vw, 120px);padding-bottom:clamp(72px, 8.4vw, 120px)\">\n<div class=\"wp-block-group alignwide is-layout-flow wp-block-group-is-layout-flow\">\n<div class=\"wp-block-group mp-naglowek-sekcji is-layout-flow wp-container-core-group-is-layout-1e0e26b3 wp-block-group-is-layout-flow\">\n<p class=\"is-style-nadtytul wp-block-paragraph\">Porównanie</p>\n\n\n\n<h2 class=\"wp-block-heading\">Co jest w <em>każdym</em> pakiecie</h2>\n</div>\n\n\n\n<div class=\"wp-block-group is-layout-flow wp-container-core-group-is-layout-8dda2550 wp-block-group-is-layout-flow\">\n<figure class=\"wp-block-table is-style-porownanie\"><table><thead><tr><th scope=\"col\">Pakiet</th><th scope=\"col\">Wizytówka</th><th scope=\"col\">Wizytówka, która umawia</th><th scope=\"col\">Pełny start</th></tr></thead><tbody><tr><th scope=\"row\">Cena</th><td>1&nbsp;200&nbsp;zł</td><td>1&nbsp;800&nbsp;zł</td><td>2&nbsp;500&nbsp;zł</td></tr><tr><th scope=\"row\">Dla kogo</th><td>Gdy wystarczy, że klient Cię znajdzie i&nbsp;napisze</td><td>Gdy chcesz mniej telefonów i&nbsp;krótsze pierwsze rozmowy</td><td>Gdy chcesz od razu zbierać opinie i&nbsp;kontakty</td></tr><tr><th scope=\"row\">Strona</th><td>Jedna strona, 6&nbsp;sekcji, wersja na telefon</td><td>To samo</td><td>To samo</td></tr><tr><th scope=\"row\">Kontakt</th><td>Formularz z&nbsp;potwierdzeniem dla klienta</td><td>Formularz wstępnych pytań i&nbsp;kalendarz konsultacji</td><td>To samo</td></tr><tr><th scope=\"row\">Treści</th><td>Napisane na podstawie ankiety</td><td>Plus odpowiedzi na najczęstsze pytania i&nbsp;miejsce na opinie</td><td>Plus film powitalny 60&nbsp;s i&nbsp;poradnik PDF dla klientów</td></tr><tr><th scope=\"row\">Google</th><td>Podstawy SEO, polityka prywatności, informacje formalne</td><td>Plus Profil Firmy w&nbsp;Google, gdy firma spełnia wytyczne</td><td>Plus system próśb o&nbsp;opinie (karta z&nbsp;kodem QR, SMS, e-mail)</td></tr><tr><th scope=\"row\">Termin</th><td>Ok.&nbsp;2&nbsp;tygodnie od otrzymania materiałów</td><td>To samo</td><td>To samo</td></tr></tbody></table><figcaption class=\"wp-element-caption\">Porównanie trzech pakietów</figcaption></figure>\n\n\n\n<p class=\"is-style-podpis wp-block-paragraph\">Na telefonie tabelę przesuwasz palcem w bok.</p>\n</div>\n</div>\n</section>\n\n\n\n<section class=\"wp-block-group alignfull has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\" id=\"masz-strone\" style=\"padding-top:clamp(72px, 8.4vw, 120px);padding-bottom:0\">\n<div class=\"wp-block-group alignwide is-layout-flow wp-block-group-is-layout-flow\">\n<div class=\"wp-block-group is-style-karta is-layout-flow wp-block-group-is-layout-flow\">\n<div class=\"wp-block-group mp-masz-strone is-layout-flex wp-container-core-group-is-layout-d9377977 wp-block-group-is-layout-flex\">\n\n\n<div class=\"wp-block-group mp-rozciagnij is-layout-flow wp-container-core-group-is-layout-94938363 wp-block-group-is-layout-flow\">\n<h2 class=\"wp-block-heading mp-h2-maly\">Masz już stronę?</h2>\n\n\n\n<p class=\"has-grafit-color has-text-color wp-block-paragraph\">Kalendarz konsultacji i formularz wstępnych pytań dodam do Twojej obecnej strony, w jej stylu.</p>\n</div>\n\n\n\n<div class=\"wp-block-group is-layout-flow wp-container-core-group-is-layout-71fc1e3e wp-block-group-is-layout-flow\">\n<div class=\"wp-block-group mp-od is-nowrap is-layout-flex wp-container-core-group-is-layout-752805cf wp-block-group-is-layout-flex\">\n<p class=\"wp-block-paragraph\">od</p>\n\n\n\n<p class=\"wp-block-paragraph\">800</p>\n\n\n\n<p class=\"wp-block-paragraph\">zł</p>\n</div>\n\n\n\n<p class=\"is-style-strzalka wp-block-paragraph\"><a href=\"/kontakt/\">Napisz, jaką masz stronę</a></p>\n</div>\n</div>\n</div>\n</div>\n</section>\n\n\n\n<section class=\"wp-block-group alignfull has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\" id=\"dodatki\" style=\"padding-top:clamp(72px, 8.4vw, 120px);padding-bottom:clamp(72px, 8.4vw, 120px)\">\n<div class=\"wp-block-group alignwide is-layout-flow wp-block-group-is-layout-flow\">\n<div class=\"wp-block-columns is-layout-flex wp-container-core-columns-is-layout-a25c9dff wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\" style=\"flex-basis:40%\">\n<p class=\"is-style-nadtytul wp-block-paragraph\">Dodatki</p>\n\n\n\n<h2 class=\"wp-block-heading\">Dodatki, gdy ich <em>potrzebujesz</em></h2>\n\n\n\n<p class=\"has-grafit-color has-text-color wp-block-paragraph\">Do każdego pakietu. Podaję ceny „od”, a dokładną kwotę dostajesz w propozycji po ankiecie.</p>\n</div>\n\n\n\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\" style=\"flex-basis:60%\">\n<ul class=\"wp-block-list is-style-lista-cennik\">\n<li>Profil Firmy w Google: założenie albo porządki <strong>od 300 zł</strong></li>\n\n\n\n<li>System próśb o opinie: karta z kodem QR, SMS i e-mail <strong>od 250 zł</strong></li>\n\n\n\n<li>Film powitalny 60 s: scenariusz, nagranie, montaż <strong>od 400 zł</strong></li>\n\n\n\n<li>Poradnik PDF dla Twoich klientów (treść merytoryczna od Ciebie) <strong>od 300 zł</strong></li>\n\n\n\n<li>Proste logo, tylko razem ze stroną <strong>od 400 zł</strong></li>\n\n\n\n<li>Statystyki odwiedzin z oknem zgód na cookies <strong>od 600 zł</strong></li>\n</ul>\n</div>\n</div>\n</div>\n</section>\n\n\n\n<section class=\"wp-block-group alignfull has-piasek-background-color has-background has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\" id=\"warunki\" style=\"padding-top:clamp(72px, 8.4vw, 120px);padding-bottom:clamp(72px, 8.4vw, 120px)\">\n<div class=\"wp-block-group alignwide is-layout-flow wp-block-group-is-layout-flow\">\n<div class=\"wp-block-group mp-naglowek-sekcji is-layout-flow wp-container-core-group-is-layout-1e0e26b3 wp-block-group-is-layout-flow\">\n<p class=\"is-style-nadtytul wp-block-paragraph\">Warunki</p>\n\n\n\n<h2 class=\"wp-block-heading\">Wszystko jest na <em>piśmie</em></h2>\n</div>\n\n\n\n<ul class=\"wp-block-list is-style-lista-znaczniki mp-kolumny\">\n<li>Zadatek 40%, reszta przed publikacją. Dwie rundy poprawek.</li>\n\n\n\n<li>Prawa autorskie do treści i grafik, które dla Ciebie tworzę, przechodzą na Ciebie po pełnej zapłacie, na podstawie umowy na piśmie. Zdjęcia z banków zdjęć, czcionki i wtyczki mają własne licencje.</li>\n\n\n\n<li>30 dni wsparcia po starcie. Potem drobne zmiany na zlecenie, wyceniane przed pracą.</li>\n\n\n\n<li>Faktura bez VAT (działalność nierejestrowana) albo faktura VAT przez Useme, wtedy cena + 23% VAT.</li>\n\n\n\n<li>Domena i hosting na Ciebie, płatne u dostawcy: pierwszy rok ok. 55–75 zł netto, potem ok. 320–370 zł netto rocznie (z VAT ok. 68–92 zł i ok. 394–455 zł).</li>\n\n\n\n<li>Propozycja jest ważna 14 dni.</li>\n\n\n\n<li>Umowę zawieramy na odległość, więc konsument i jednoosobowa firma mają 14 dni na odstąpienie; zasady są w <a href=\"/regulamin/\">regulaminie</a>.</li>\n</ul>\n</div>\n</section>\n\n\n\n<section class=\"wp-block-group alignfull has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\" id=\"nastepny-krok\" style=\"padding-top:clamp(72px, 8.4vw, 120px);padding-bottom:clamp(72px, 8.4vw, 120px)\">\n<div class=\"wp-block-group alignwide is-layout-flow wp-container-core-group-is-layout-8b1746a0 wp-block-group-is-layout-flow\">\n<div class=\"wp-block-group is-layout-flow wp-container-core-group-is-layout-1e0e26b3 wp-block-group-is-layout-flow\">\n<p class=\"is-style-nadtytul wp-block-paragraph\">Następny krok</p>\n\n\n\n<div class=\"wp-block-group is-style-cta is-style-ciemna has-krem-color has-czern-background-color has-text-color has-background is-layout-flow wp-container-core-group-is-layout-8d8f77af wp-block-group-is-layout-flow\">\n<h2 class=\"wp-block-heading\">Sprawdź, ile kosztowałaby <em>Twoja</em> strona</h2>\n\n\n\n<p class=\"wp-block-paragraph\">5 minut pytań, jednostronicowa propozycja w 48 godzin. Wypełnienie do niczego nie zobowiązuje.</p>\n\n\n\n<div class=\"wp-block-buttons is-content-justification-center is-layout-flex wp-container-core-buttons-is-layout-d6955148 wp-block-buttons-is-layout-flex\">\n<div class=\"wp-block-button ze-strzalka\"><a class=\"wp-block-button__link wp-element-button\" href=\"#ankieta\">Wyceń stronę w 5 minut</a></div>\n\n\n\n<div class=\"wp-block-button is-style-outline is-style-outline--6\"><a class=\"wp-block-button__link wp-element-button\" href=\"#rozmowa\">Wolisz porozmawiać? Umów 30 minut</a></div>\n</div>\n</div>\n</div>\n\n\n\n<div class=\"wp-block-group mp-zobacz-tez is-layout-flex wp-block-group-is-layout-flex\">\n<p class=\"wp-block-paragraph\">Zobacz też:</p>\n\n\n\n<p class=\"is-style-strzalka wp-block-paragraph\"><a href=\"/jak-pracuje/\">Jak pracuję</a></p>\n\n\n\n<p class=\"is-style-strzalka wp-block-paragraph\"><a href=\"/pytania/\">Pytania o cenę i warunki</a></p>\n</div>\n</div>\n</section>\n",
